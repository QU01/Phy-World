+"use client";
+
+// Gráficos pequeños del explorador de World4: SVG propio (sin librería), tokens de Studio.
+
+import { CHANNEL_COLORS, fmt } from "./scales";
+
+type Num = number | null | undefined;
+
+function finite(v: Num): v is number {
+  return typeof v === "number" && Number.isFinite(v);
+}
+
+/** Línea p50 con banda p10-p90 (opcional) y un año marcado. */
+export function BandSparkline({
+  years,
+  p50,
+  p10,
+  p90,
+  baseline,
+  mark,
+  width = 300,
+  height = 84,
+  color = "var(--electric)",
+}: {
+  years: number[];
+  p50: Num[];
+  p10?: Num[];
+  p90?: Num[];
+  baseline?: Num[];
+  mark?: number | null;
+  width?: number;
+  height?: number;
+  color?: string;
+}) {
+  const vals = [...p50, ...(p10 ?? []), ...(p90 ?? []), ...(baseline ?? [])].filter(finite);
+  if (!vals.length || years.length < 2) return null;
+  let lo = Math.min(...vals);
+  let hi = Math.max(...vals);
+  if (hi === lo) { hi += 1; lo -= 1; }
+  const pad = { l: 34, r: 6, t: 6, b: 16 };
+  const X = (i: number) => pad.l + (i / (years.length - 1)) * (width - pad.l - pad.r);
+  const Y = (v: number) => pad.t + (1 - (v - lo) / (hi - lo)) * (height - pad.t - pad.b);
+  const path = (s: Num[]) =>
+    s.reduce<string>((acc, v, i) => (finite(v) ? acc + `${acc && !acc.endsWith("M") ? "L" : "M"}${X(i).toFixed(1)},${Y(v).toFixed(1)}` : acc), "");
+  let band = "";
+  if (p10 && p90) {
+    const up = p90.map((v, i) => (finite(v) ? `${X(i).toFixed(1)},${Y(v).toFixed(1)}` : null)).filter(Boolean);
+    const dn = p10.map((v, i) => (finite(v) ? `${X(i).toFixed(1)},${Y(v).toFixed(1)}` : null)).filter(Boolean).reverse();
+    if (up.length && dn.length) band = `M${up.join("L")}L${dn.join("L")}Z`;
+  }
+  const mi = mark !== null && mark !== undefined ? years.indexOf(mark) : -1;
+  return (
+    <svg width="100%" viewBox={`0 0 ${width} ${height}`} style={{ display: "block" }} role="img">
+      <text x={2} y={pad.t + 8} fill="var(--ink-dim)" fontSize="9" fontFamily="var(--quasar-font-mono)">{fmt(hi)}</text>
+      <text x={2} y={height - pad.b} fill="var(--ink-dim)" fontSize="9" fontFamily="var(--quasar-font-mono)">{fmt(lo)}</text>
+      <text x={pad.l} y={height - 3} fill="var(--ink-dim)" fontSize="9" fontFamily="var(--quasar-font-mono)">{years[0]}</text>
+      <text x={width - pad.r} y={height - 3} textAnchor="end" fill="var(--ink-dim)" fontSize="9" fontFamily="var(--quasar-font-mono)">{years[years.length - 1]}</text>
+      {band ? <path d={band} fill={color} opacity={0.18} /> : null}
+      {baseline ? <path d={path(baseline)} fill="none" stroke="var(--ink-dim)" strokeWidth={1.2} strokeDasharray="3 3" /> : null}
+      <path d={path(p50)} fill="none" stroke={color} strokeWidth={1.8} />
+      {mi >= 0 ? <line x1={X(mi)} x2={X(mi)} y1={pad.t} y2={height - pad.b} stroke="var(--ink-muted)" strokeWidth={1} strokeDasharray="2 2" /> : null}
+      {mi >= 0 && finite(p50[mi]) ? <circle cx={X(mi)} cy={Y(p50[mi] as number)} r={3} fill={color} /> : null}
+    </svg>
+  );
+}
+
+/** Reparto de la renta de un agente entre los seis canales, una columna apilada por año. */
+export function DecisionColumns({
+  years,
+  shares,
+  names,
+  mark,
+  width = 300,
+  height = 110,
+}: {
+  years: number[];
+  shares: Num[][]; // [año][canal]
+  names: string[];
+  mark?: number | null;
+  width?: number;
+  height?: number;
+}) {
+  const totals = shares.map((row) => row.reduce<number>((a, v) => a + (finite(v) ? v : 0), 0));
+  const top = Math.max(...totals, 1e-9);
+  const pad = { l: 4, r: 4, t: 4, b: 14 };
+  const cw = (width - pad.l - pad.r) / years.length;
+  return (
+    <svg width="100%" viewBox={`0 0 ${width} ${height}`} style={{ display: "block" }} role="img">
+      {shares.map((row, i) => {
+        let y = height - pad.b;
+        const x = pad.l + i * cw + cw * 0.12;
+        const w = cw * 0.76;
+        return (
+          <g key={years[i]} opacity={mark === undefined || mark === null || mark === years[i] ? 1 : 0.55}>
+            {row.map((v, j) => {
+              if (!finite(v) || v <= 0) return null;
+              const h = (v / top) * (height - pad.t - pad.b);
+              y -= h;
+              return <rect key={names[j]} x={x} y={y} width={w} height={h} fill={CHANNEL_COLORS[names[j]] ?? "#64748b"} />;
+            })}
+            {i === 0 || i === years.length - 1 ? (
+              <text x={x + w / 2} y={height - 2} textAnchor="middle" fill="var(--ink-dim)" fontSize="9"
+                fontFamily="var(--quasar-font-mono)">{years[i]}</text>
+            ) : null}
+          </g>
+        );
+      })}
+    </svg>
+  );
+}
