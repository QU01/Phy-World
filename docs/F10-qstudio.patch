+
+      <span style={labelStyle}>{t("world4.agent.partners", { year })}</span>
+      <div className="grid grid-cols-2 gap-2">
+        {([["trade", "out", "exportsTo"], ["trade", "in", "importsFrom"], ["drain", "out", "drainsTo"], ["drain", "in", "drainsFrom"]] as const).map(([kind, dir, key]) => {
+          const rows = partners(kind, dir);
