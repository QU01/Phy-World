+// Datos del explorador de World4 (F10): los JSON que una corrida de `world4` deja en su run dir
+// (`world4.explorer` en el paquete). Se leen por el endpoint de entregables, que es público en local
+// (mismo camino que `fetchPhyArtifactBlobUrl`): `fetch` sin Authorization = sin preflight CORS.
+
+import { listPhyRuns, phyArtifactUrl, type PhyRunSnapshot } from "./phyModels";
+
+export const WORLD4_SCHEMA = "world4-explorer-1";
+
+/** p10/p50/p90 por país y año: `[país][año]` (null = sin dato). */
+export interface QuantileSeries {
+  label: string;
+  unit: string;
+  p10: (number | null)[][];
+  p50: (number | null)[][];
+  p90: (number | null)[][];
+}
+
+/** Frecuencia de un indicador 0/1 entre los miembros: `[país][año]`. */
+export interface FrequencySeries {
+  label: string;
+  unit: string;
+  mean: (number | null)[][];
+  band: string;
+}
+
+export type CountrySeries = QuantileSeries | FrequencySeries;
+
+export interface Band1D {
+  unit: string;
+  p10: (number | null)[];
+  p50: (number | null)[];
+  p90: (number | null)[];
+  baseline_p50?: (number | null)[];
+}
+
+export interface Flows {
+  /** Por año: `[origen, destino, valor]` con índices de `countries`. */
+  trade: [number, number, number][][];
+  drain: [number, number, number][][];
+  /** Por país y año, los mayores socios `[índice, valor]` en cada sentido (los países pequeños no salen en el top mundial). */
+  partners?: Record<"trade_out" | "trade_in" | "drain_out" | "drain_in", [number, number][][][]>;
+  unit?: string;
+  row_format?: string;
+  band?: string;
+  note?: string;
+}
+
+export interface World4Country {
+  iso3: string;
+  isonum: number;
+  region: string | null;
+}
+
+export interface World4L1 {
+  origin: number;
+  years: number[];
+  members: number;
+  sectors: string;
+  countries: World4Country[];
+  series: Record<string, CountrySeries>;
+  channels: {
+    names: string[];
+    labels: Record<string, string>;
+    unit: string;
+    share: (number | null)[][][];
+    band: string;
+    note: string;
+  };
+  flows: Flows;
+  world: Record<string, Band1D>;
+  caveats: string[];
+  horizon_note: string;
+}
+
+export interface World4Region {
+  name: string;
+  gdp_pc: Band1D;
+  population: Band1D;
+  debt_gdp: Band1D;
+  cereal_pc: Band1D;
+  nonfossil_share: Band1D;
+}
+
+export interface World4L0 {
+  years: number[];
+  /** País → región del L0 (también en corridas L0, para colorear el globo por región). */
+  countries: World4Country[];
+  world: Record<string, Band1D>;
+  regions: Record<string, World4Region>;
+  members: number;
+  narrative: string;
+  band: string;
+}
+
+export interface World4Payload {
+  schema: string;
+  model_revision: number;
+  narrative: string;
+  theta: Record<string, number>;
+  exploratory: boolean;
+  l0: World4L0;
+  l1: World4L1 | null;
+  l1_note?: string;
+}
+
+export interface GeoFeature {
+  type: "Feature";
+  id: number;
+  properties: { name: string; centroid: [number, number] };
+  geometry:
+    | { type: "Polygon"; coordinates: number[][][] }
+    | { type: "MultiPolygon"; coordinates: number[][][][] };
+}
+
+export interface GeoPayload {
+  type: "FeatureCollection";
+  features: GeoFeature[];
+  sha256?: string;
+}
+
+export interface GraphMetric {
+  label: string;
+  value: number | null;
+  unit: string;
+}
+
+export interface GraphNode {
+  id: string;
+  kind: string;
+  label: string;
+  description: string;
+  status: string;
+  metrics: GraphMetric[];
+  series?: { years: number[]; values: (number | null)[]; unit: string; label: string; band: string } | null;
+  caveats?: string[];
+  provenance?: Record<string, unknown>;
+}
+
+export interface GraphEdge {
+  id: string;
+  source: string;
+  target: string;
+  label: string;
+  kind: string;
+}
+
+export interface LoopsPayload {
+  stocks: string[];
+  links: { source: string; target: string; flow: string }[];
+  loops: string[];
+  dominant_by_decade: { year: number; loops: { loop: string; score: number }[] }[];
+  unit: string;
+  band: string;
+}
+
+export interface GraphPayload {
+  nodes: GraphNode[];
+  edges: GraphEdge[];
+  loops?: LoopsPayload;
+}
+
+export interface PolicyPayload {
+  theta: Record<string, number>;
+  narrative: string;
+  members: number;
+  objectives: Record<string, number>;
+  constraints: Record<string, number>;
+  baseline_objectives: Record<string, number>;
+  baseline_constraints: Record<string, number>;
+  feasible: boolean;
+  better_than_baseline_share: { welfare: number; peak_gmst: number };
+  units: Record<string, string>;
+  vulnerability?: Record<string, unknown>;
+}
+
+export interface World4RunData {
+  runId: string;
+  world: World4Payload;
+  geo: GeoPayload;
+  graph: GraphPayload | null;
+  policy: PolicyPayload | null;
+}
+
+async function fetchJson<T>(modelId: string, runId: string, path: string): Promise<T | null> {
+  try {
+    const res = await fetch(phyArtifactUrl(modelId, runId, path));
+    if (!res.ok) return null;
+    return (await res.json()) as T;
+  } catch {
+    return null;
+  }
+}
+
+/** Los datos del explorador de una corrida terminada; null si le falta `world.json` o `geo.json`. */
+export async function loadWorld4Run(modelId: string, runId: string): Promise<World4RunData | null> {
+  const [world, geo, graph, policy] = await Promise.all([
+    fetchJson<World4Payload>(modelId, runId, "world.json"),
+    fetchJson<GeoPayload>(modelId, runId, "geo.json"),
+    fetchJson<GraphPayload>(modelId, runId, "graph.json"),
+    fetchJson<PolicyPayload>(modelId, runId, "policy.json"),
+  ]);
+  if (!world || !geo || world.schema !== WORLD4_SCHEMA) return null;
+  return { runId, world, geo, graph, policy };
+}
+
+/** Corridas TERMINADAS del modelo, la más reciente primero. */
+export async function listWorld4Runs(modelId: string): Promise<PhyRunSnapshot[]> {
+  const runs = await listPhyRuns(modelId);
+  return runs
+    .filter((r) => r.status === "done")
+    .sort((a, b) => String(b.created_at ?? "").localeCompare(String(a.created_at ?? "")));
+}
+
+export function isFrequency(s: CountrySeries): s is FrequencySeries {
+  return (s as FrequencySeries).mean !== undefined;
+}
+
+/** Valor central de una serie por país y año (p50 o la frecuencia). */
+export function centralValue(s: CountrySeries, country: number, year: number): number | null {
+  const grid = isFrequency(s) ? s.mean : s.p50;
+  const v = grid[country]?.[year];
+  return typeof v === "number" && Number.isFinite(v) ? v : null;
+}
