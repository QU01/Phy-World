+// ── el pulso del mundo (sin país elegido) ─────────────────────────────────────
+
+function WorldPulse({ data, yearIdx, moveOf, eventsOf, nameOf, onPickIso }: {
+  data: World4RunData;
+  yearIdx: number;
+  moveOf: (i: number, k: number) => { ch: string; d: number } | null;
+  eventsOf: (i: number, k: number) => { kind: "conflict" | "crisis" | "coup"; p: number }[];
+  nameOf: (iso3: string) => string;
+  onPickIso: (iso3: string) => void;
+}) {
+  const t = useT();
+  const { world } = data;
+  const l1 = world.l1;
+  const year = (l1 ? l1.years : world.l0.years)[yearIdx];
+  const movers = useMemo(() => {
+    if (!l1) return [];
+    return l1.countries
+      .map((c, i) => ({ c, mv: moveOf(i, yearIdx) }))
+      .filter((x) => x.mv)
+      .sort((a, b) => Math.abs((b.mv as { d: number }).d) - Math.abs((a.mv as { d: number }).d))
+      .slice(0, 8);
+  }, [l1, moveOf, yearIdx]);
+  const events = useMemo(() => {
+    if (!l1) return [];
+    return l1.countries.flatMap((c, i) => eventsOf(i, yearIdx).map((e) => ({ c, ...e })))
+      .sort((a, b) => b.p - a.p).slice(0, 10);
+  }, [l1, eventsOf, yearIdx]);
+  const card = { background: "var(--surface-0)", border: "1px solid rgba(255,255,255,0.06)" };
+  const w0 = world.l0.world;
+  const last = world.l0.years.length - 1;
+  return (
+    <>
+      <div className="flex flex-col gap-2 rounded-lg p-4" style={card}>
+        <span style={{ fontFamily: "var(--quasar-font-display)", fontSize: "16px", color: "var(--ink-primary)" }}>{t("world4.pulse.title", { year })}</span>
+        {l1 ? (
+          <div className="grid grid-cols-1 gap-1">
+            {Object.entries(l1.world).map(([k, b]) => (
+              <div key={k} className="flex items-baseline justify-between gap-2">
+                <span style={{ ...monoStyle, fontSize: "11px" }}>{t(`world4.layers.world_${k}`)}</span>
+                <span style={{ ...monoStyle, fontSize: "12px", color: "var(--ink-primary)" }}>
+                  {fmt(b.p50[yearIdx])} <span style={{ color: "var(--ink-dim)" }}>[{fmt(b.p10[yearIdx])}–{fmt(b.p90[yearIdx])}]</span>
+                </span>
+              </div>
+            ))}
+          </div>
+        ) : null}
+        <span style={{ ...monoStyle, fontSize: "11px", color: "var(--ink-dim)" }}>{t("world4.pulse.pickHint")}</span>
+      </div>
+      {l1 ? (
+        <div className="flex flex-col gap-2 rounded-lg p-4" style={card}>
+          <span style={labelStyle}>{t("world4.pulse.movers")}</span>
+          <span style={{ ...monoStyle, fontSize: "10px", color: "var(--ink-dim)" }}>{t("world4.pulse.moversNote")}</span>
+          {movers.map(({ c, mv }) => (
+            <button key={c.iso3} type="button" onClick={() => onPickIso(c.iso3)} className="flex items-center justify-between gap-2 text-left">
+              <span style={{ ...monoStyle, fontSize: "12px", color: "var(--ink-primary)" }}>{nameOf(c.iso3)}</span>
+              <span className="flex items-center gap-1.5" style={{ ...monoStyle, fontSize: "11px" }}>
+                <span style={{ width: 8, height: 8, borderRadius: 999, background: CHANNEL_COLORS[(mv as { ch: string }).ch] }} />
+                {shiftText(t, mv as { ch: string; d: number })}
+              </span>
+            </button>
+          ))}
+          <span style={{ ...labelStyle, marginTop: 6 }}>{t("world4.pulse.events")}</span>
+          {events.length ? events.map((e) => (
+            <button key={`${e.c.iso3}-${e.kind}`} type="button" onClick={() => onPickIso(e.c.iso3)} className="flex items-center justify-between gap-2 text-left">
