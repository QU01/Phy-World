+++ b/backend/tests/test_model_world4.py
@@ -0,0 +1,242 @@
+"""Phy-World (World4) como addon de Studio — F10 de su hoja de ruta (§5).
+
+Entra con UN manifest (``Phy-Models/manifests/world4.json``) y UN adaptador (``models/world4.py``); toda la
+lógica de la corrida vive en el paquete (``world4.studio_compat.run_studio``). Lo distinto de este modelo:
+
+  - θ son las 7 palancas de política de F8 y las familias son ``scenario`` (``--theta``) y ``design``
+    (``--design``, la búsqueda robusta con ``phycore.Designer``).
+  - L2 se declara y NO se ofrece (sus emuladores ya están dentro del L1); L0 y L1 con coste MEDIDO.
+  - La corrida deja los datos del explorador (``world.json``, ``geo.json``, ``graph.json``) que pinta el slot
+    ``world_explorer``, y todos pasan la auditoría de honestidad W11 del propio World4.
+  - ``fair`` es requisito real (hasta el L0 lee el CO2 observado con él): sin él, ``dependency_missing``.
+  - QUO pregunta con ``world4_read`` (las mismas funciones puras que el servidor MCP de World4).
+
+Los tests de corrida necesitan los datos de World4 instalados (``world4_cli.py --install-*``); sin ellos se
+saltan con la razón. Lo que pasa de unos segundos va marcado ``slow``.
+"""
+
+from __future__ import annotations
+
+import json
+import time
+from pathlib import Path
+
+import pytest
+
+MODEL_ID = "world4"
+LEVERS = ["carbon_price", "renewables", "efficiency", "agri_rd", "aid", "fertility", "consolidation"]
+
+
+@pytest.fixture
+def ws(monkeypatch, tmp_path):
+    monkeypatch.setenv("QUASAR_WORKSPACE_DIR", str(tmp_path / "ws"))
+    from app.services import workspace_service
+
+    workspace_service.reset_workspace_dir()
+    yield tmp_path / "ws"
+    workspace_service.reset_workspace_dir()
+
+
+def _svc():
+    from app.services.phy_models import registry, services
+
+    row = {r["id"]: r for r in registry.list_models()}.get(MODEL_ID)
+    if row is None or not row.get("available"):
+        pytest.skip(f"World4 no está en Phy-Models/World4 o le faltan dependencias: {row and row.get('reason')}")
+    return services.get_service(MODEL_ID)
+
+
+def _data_or_skip(svc):
+    ns = svc._ns
+    with ns.isolation.activate():
+        from world4.data import atlas, climate, energy, food, wpp
+
+        missing = [n for n, m in (("climate", climate), ("energy", energy), ("food", food), ("wpp", wpp))
+                   if not m.available()]
+        try:
+            atlas.require()
+        except Exception:
+            missing.append("atlas")
+    if missing:
+        pytest.skip(f"datos de World4 sin instalar: {missing} (world4_cli.py --install-*)")
+
+
+def _wait(svc, rid, timeout=600, until=lambda s: s["status"] != "running"):
+    t0 = time.time()
+    while time.time() - t0 < timeout:
+        snap = svc.get_run(rid)
+        if until(snap):
+            return snap
+        time.sleep(0.2)
+    raise AssertionError(f"la corrida {rid} no terminó en {timeout} s")
+
+
+# ── Registro, Protocol y disponibilidad ──────────────────────────────────────────
+
+def test_manifest_y_protocol():
+    from app.services.phy_models.protocol import PhyService
+
+    svc = _svc()
+    assert isinstance(svc, PhyService)
+    assert svc.capabilities == frozenset({"evaluate_theta", "cancel_run", "report"})
+    m = svc.manifest
+    assert m["domain"] == "society.world_system" and m["geometry"] is None
+    assert "No figure is a prediction" in m["honesty_note"]
+    kinds = [s["kind"] for s in m["slots"]]
+    assert kinds == ["choice_family", "world_explorer"]
+
+
+def test_sin_fair_dependency_missing(monkeypatch):
+    """Sin ``fair`` la card sale ``dependency_missing`` con el ``pip install -r`` de su requirements."""
