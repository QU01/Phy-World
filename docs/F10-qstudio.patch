+      const y = centralValue(l1.series.gdp_pc, i, yearIdx);
+      const p = centralValue(l1.series.population, i, yearIdx);
+      return y && p ? y * p : 0;
+    });
+    const top = Math.max(...gdp, 1);
+    const out: GlobeAgent[] = [];
+    features.forEach((f, fi) => {
+      const i = featureCountry[fi];
+      if (i === null) return;
+      const mv = moveOf(i, yearIdx);
+      const ev = eventsOf(i, yearIdx);
+      out.push({
+        lon: f.properties.centroid[0], lat: f.properties.centroid[1], size: gdp[i] / top,
+        color: mv ? CHANNEL_COLORS[mv.ch] ?? "#94a3b8" : "#94a3b8", pulse: ev.length ? 1 + fi * 0.01 : 0, feature: fi,
+      });
+    });
+    return out;
+  }, [l1, showAgents, features, featureCountry, yearIdx, moveOf, eventsOf]);
