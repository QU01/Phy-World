+  "conflict", "crisis", "coup", "drain", "net_rents"];
+
+function AgentCard({ data, country, name, yearIdx, layer, layerName, growth, onClose, onAsk, moveOf, nameOf }: {
+  data: World4RunData;
+  country: number;
+  name: string;
+  yearIdx: number;
+  layer: string;
+  layerName: string;
+  growth: (number | null)[][];
+  onClose: () => void;
+  onAsk: (t: AskTarget) => void;
+  moveOf: (i: number, k: number) => { ch: string; d: number } | null;
+  nameOf: (iso3: string) => string;
+}) {
+  const t = useT();
+  const l1 = data.world.l1!;
+  const c = l1.countries[country];
+  const year = l1.years[yearIdx];
+  const mv = moveOf(country, yearIdx);
+  const card = { background: "var(--surface-0)", border: "1px solid rgba(255,255,255,0.06)" };
+  const s: CountrySeries | undefined = layer === "growth" ? undefined : l1.series[layer];
+  const partners = (kind: "trade" | "drain", dir: "out" | "in") => {
+    const own = l1.flows.partners?.[`${kind}_${dir}`]?.[country]?.[yearIdx];
+    if (own) return own.map(([j, v]) => ({ iso3: l1.countries[j].iso3, v }));
+    return (l1.flows[kind]?.[yearIdx] ?? [])
+      .filter(([a, b]) => (dir === "out" ? a === country : b === country))
+      .slice(0, 3)
+      .map(([a, b, v]) => ({ iso3: l1.countries[dir === "out" ? b : a].iso3, v }));
+  };
+  return (
+    <div className="flex flex-col gap-3 rounded-lg p-4" style={card}>
+      <div className="flex items-start justify-between gap-2">
+        <div className="flex flex-col">
+          <span style={{ fontFamily: "var(--quasar-font-display)", fontSize: "18px", color: "var(--ink-primary)" }}>{name}</span>
+          <span className="flex items-center gap-2" style={{ ...monoStyle, fontSize: "11px" }}>
+            {c.iso3}{c.region ? <Badge tone="dim">{t("world4.agent.region", { region: c.region })}</Badge> : null}
+          </span>
+        </div>
+        <button type="button" onClick={onClose} aria-label={t("world4.agent.close")} style={{ color: "var(--ink-dim)" }}><X size={16} /></button>
+      </div>
+
+      <span style={labelStyle}>{t("world4.agent.state", { year })}</span>
+      <div className="grid gap-x-3 gap-y-1" style={{ gridTemplateColumns: "1fr auto" }}>
+        {STATE_KEYS.filter((k) => l1.series[k]).map((k) => {
+          const sr = l1.series[k];
+          const v = centralValue(sr, country, yearIdx);
+          const q = isFrequency(sr) ? null : (sr as QuantileSeries);
+          return (
+            <div key={k} className="contents">
+              <span style={{ ...monoStyle, fontSize: "11px" }} title={sr.unit}>{t(`world4.layers.${k}`)}</span>
+              <span style={{ ...monoStyle, fontSize: "11px", color: "var(--ink-primary)", textAlign: "right" }}>
+                {isFrequency(sr) ? pct(v) : fmt(v)}
+                {q ? <span style={{ color: "var(--ink-dim)" }}> [{fmt(q.p10[country]?.[yearIdx])}–{fmt(q.p90[country]?.[yearIdx])}]</span> : null}
+              </span>
+            </div>
+          );
+        })}
+      </div>
+
+      <span style={labelStyle}>{t("world4.agent.trajectory", { layer: layerName })}</span>
+      {s ? (
+        <BandSparkline years={l1.years} p50={isFrequency(s) ? s.mean[country] : s.p50[country]}
+          p10={isFrequency(s) ? undefined : s.p10[country]} p90={isFrequency(s) ? undefined : s.p90[country]} mark={year} />
+      ) : (
+        <BandSparkline years={l1.years} p50={growth[country] ?? []} mark={year} />
+      )}
+
+      <span style={labelStyle}>{t("world4.agent.decisions")}</span>
+      <DecisionColumns years={l1.years} shares={l1.channels.share[country] ?? []} names={l1.channels.names} mark={year} />
+      <div className="flex flex-wrap gap-x-3 gap-y-1">
+        {l1.channels.names.map((ch) => (
+          <span key={ch} className="flex items-center gap-1" style={{ ...monoStyle, fontSize: "10px" }}>
+            <span style={{ width: 8, height: 8, borderRadius: 2, background: CHANNEL_COLORS[ch] }} />
+            {t(`world4.channels.${ch}`)} {pct(l1.channels.share[country]?.[yearIdx]?.[l1.channels.names.indexOf(ch)] ?? null)}
