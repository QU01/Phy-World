+from app.services.prime_radiant.structural import runner, validation
+from tests.test_prime_radiant_pipeline import setup  # noqa: F401  (fixture con proveedores falsos)
+
+BLOCK = {"status": "ok", "variable": "conflict", "what": "armed conflict", "region": "COL", "kind": "binary",
+         "as_of": "2026-10-11", "window": [2027, 2028], "origin": 2019, "k": [8, 9], "live": True,
+         "exploratory": True, "caveats": ["origin 2019"], "p_raw": 0.66, "p": 0.71,
+         "calibrator": {"kind": "isotonic", "n": 900},
+         "base_rate_data": {"status": "ok", "p_window": 0.9, "p_year": 0.69, "reference_class": "COL"},
+         "provenance": {"model_revision": 1}}
+
+
+def fake_world4(tmp_path, answer: dict | str, sleep: float = 0.0) -> Path:
+    root = tmp_path / "w4"
+    root.mkdir()
+    payload = answer if isinstance(answer, str) else json.dumps(answer)
+    (root / "world4_cli.py").write_text(textwrap.dedent(f"""
+        import json, sys, time
+        req = json.loads(sys.stdin.read())
+        time.sleep({sleep})
+        open(r"{(root / 'last_request.json').as_posix()}", "w").write(json.dumps(req))
+        print({payload!r})
+    """), encoding="utf-8")
+    return root
+
+
+@pytest.fixture
+def world4(tmp_path, monkeypatch):
+    def configure(answer, sleep=0.0, timeout=30):
+        root = fake_world4(tmp_path, answer, sleep)
+        monkeypatch.setenv("QUASAR_PR_STRUCTURAL_ENABLED", "1")
+        monkeypatch.setenv("QUASAR_PR_WORLD4_PYTHON", sys.executable)
+        monkeypatch.setenv("QUASAR_PR_WORLD4_DIR", str(root))
+        monkeypatch.setenv("QUASAR_PR_WORLD4_TIMEOUT_S", str(timeout))
+        return root
+    return configure
+
+
+def question(**kw):
+    base = dict(id="s" * 32, text="Will there be armed conflict in Colombia?", rules="UCDP/PRIO counts.",
+                closes_at=now() + timedelta(days=800), created_at=now())
+    return Question(**{**base, **kw})
+
+
+# ------------------------------------------------------------------ enlace
+def test_binding_must_match_question_kind():
+    question(structural={"variable": "conflict", "region": "COL"})
+    with pytest.raises(ValueError):
+        question(structural={"variable": "gdp_pc_growth", "region": "COL"})
+    with pytest.raises(ValueError):
+        StructuralBinding(variable="conflict", region="col")
+
+
+def test_old_questions_without_binding_still_load():
+    assert question().structural is None
+
+
+# ------------------------------------------------------------------ runner
