+# ── Phy-World (World4), F10: lecturas de QUO ────────────────────────────────────
+# Las MISMAS funciones puras que el servidor MCP de World4 (``world4.mcp.tools``: HTTP, MCP y QUO no pueden
+# divergir) más la lectura de una corrida de Studio terminada (``world.json``: los países como agentes).
+_W4_RUN_TOOLS = ("run_country", "run_summary")
+
+
+def world4_read(tool: str, arguments_json: str = "{}") -> dict:
+    """Pregunta a Phy-World (World4) sin lanzar corridas: catálogo, consultas del L1, palancas, una política,
+    bandas del L0, lazos dominantes, y lo que una corrida de Studio terminada dice de un país.
+
+    Herramientas (``tool``) y sus argumentos (``arguments_json``, un objeto JSON):
+
+    - ``w4_catalog`` ``{}``: variables con unidad, fidelidad y horizonte medido.
+    - ``w4_query`` ``{"variable", "region" (ISO3 o WLD), "as_of" (1970-2018), "target" (1-10 años después),
+      "members"?}``: distribución p10/p50/p90 del L1 con unidad y salvedades. Unos segundos.
+    - ``w4_levers`` ``{}``: las 7 palancas (caja, unidad, signo declarado) y las narrativas SSP.
+    - ``w4_evaluate_policy`` ``{"theta": {palanca: valor}, "narrative"?, "members"?, "vulnerability"?}``: una
+      política sobre el ensemble del L0 a 2100 (exploratorio). Unos segundos.
+    - ``w4_l0r_bands`` ``{"start"?, "years"?, "members"?, "explore"?}``: bandas mundiales del L0 regional.
+    - ``w4_loop_dominance`` ``{"top"?, "step"?}``: lazos dominantes del L0 por década.
+    - ``run_summary`` ``{"run_id"}``: resumen de una corrida de World4 de Studio (objetivos, límites, política,
+      mundo en 2100).
+    - ``run_country`` ``{"run_id", "iso3"}``: la trayectoria de un país-agente en esa corrida (estado con
+      bandas, sus seis canales de decisión y sus mayores flujos de comercio y drenaje).
+
+    Todo resultado lleva unidad y banda (o dice por qué no) y ``exploratory``; nada es un pronóstico más allá de
+    10 años.
+
+    Args:
+        tool: Nombre de la herramienta (ver la lista).
+        arguments_json: Sus argumentos como objeto JSON (``"{}"`` si no lleva).
+
+    Returns:
+        El resultado de la herramienta, o ``{"error"}`` con el motivo (World4 no disponible, argumento
+        desconocido, dato sin instalar con su remedio…).
+    """
+    import json as _json
+
+    try:
+        args = _json.loads(arguments_json or "{}")
+    except ValueError as exc:
+        return {"error": f"arguments_json no es JSON válido: {exc}"}
+    if not isinstance(args, dict):
+        return {"error": "arguments_json debe ser un objeto JSON"}
+    svc = _phy_service("world4")
+    if isinstance(svc, dict):
+        return svc
+    if tool in _W4_RUN_TOOLS:
+        return _world4_run_read(svc, tool, args)
+    try:
+        ns = svc._ns
+        with ns.isolation.activate():
+            from world4.mcp import tools as w4tools
+
+            if tool not in w4tools.TOOLS:
+                return {"error": f"herramienta desconocida {tool!r}; herramientas: "
+                                 f"{sorted([*w4tools.TOOLS, *_W4_RUN_TOOLS])}"}
+            return _jsonable_w4(w4tools.call(tool, args))
+    except (ValueError, KeyError) as exc:
+        return {"error": str(exc), "tool": tool}
+    except Exception as exc:  # dato sin instalar, QueryError…: el mensaje trae el remedio
+        return {"error": f"{type(exc).__name__}: {exc}", "tool": tool}
+
+
+def _jsonable_w4(obj):
+    import json as _json
+
+    return _json.loads(_json.dumps(obj, default=lambda o: o.tolist() if hasattr(o, "tolist") else str(o)))
+
+
+def _world4_run_read(svc, tool: str, args: dict) -> dict:
+    import json as _json
+
+    run_id = str(args.get("run_id") or "")
+    try:
+        snap = svc.get_run(run_id)
+    except ValueError as exc:
+        return {"error": str(exc)}
+    if snap is None:
+        return {"error": f"corrida world4 {run_id!r} no encontrada"}
+    if snap.get("status") != "done":
+        return {"error": f"la corrida {run_id} no ha terminado (status {snap.get('status')})"}
+    try:
+        world = _json.loads((svc.run_dir(run_id) / "world.json").read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        return {"error": f"la corrida {run_id} no tiene world.json"}
+    result = snap.get("result") or {}
