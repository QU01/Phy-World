+// Escalas de color y formato del explorador de World4. Paletas fijas pensadas para el fondo oscuro de
+// Studio: secuencial (azul profundo → cian → ámbar) y divergente (azul ↔ gris ↔ rojo) alrededor de 0.
+
+import type { CountrySeries, World4L1 } from "@/lib/world4";
+import { centralValue } from "@/lib/world4";
+
+const SEQ = ["#1b2a4a", "#1d4e89", "#1f7fb4", "#2fb3c9", "#7fd3b0", "#e5d36a", "#f59e0b"];
+const DIV = ["#2563eb", "#60a5fa", "#a5c7f0", "#64748b", "#f2a6a0", "#f87171", "#dc2626"];
+
+export const CHANNEL_COLORS: Record<string, string> = {
+  k: "#3AA0FF", // capital
+  r: "#a78bfa", // tecnología
+  m: "#5CC8E8", // importar del centro
+  x: "#f59e0b", // extracción propia
+  f: "#E23EC0", // recursos fuera
+  w: "#22C55E", // redistribución
+};
+
+export const FLOW_COLORS = { trade: "#5CC8E8", drain: "#f97316" } as const;
+
+function lerpHex(a: string, b: string, t: number): string {
+  const pa = parseInt(a.slice(1), 16);
+  const pb = parseInt(b.slice(1), 16);
+  const ch = (p: number, s: number) => (p >> s) & 255;
+  const mix = (s: number) => Math.round(ch(pa, s) + (ch(pb, s) - ch(pa, s)) * t);
+  return `rgb(${mix(16)},${mix(8)},${mix(0)})`;
+}
+
+function ramp(stops: string[], t: number): string {
+  const x = Math.min(Math.max(t, 0), 1) * (stops.length - 1);
+  const i = Math.min(Math.floor(x), stops.length - 2);
+  return lerpHex(stops[i], stops[i + 1], x - i);
+}
+
+export interface Scale {
+  lo: number;
+  hi: number;
+  log: boolean;
+  diverging: boolean;
+  color: (v: number | null) => string | null;
+}
+
+/** Escala sobre TODOS los años (así la evolución se ve) con los percentiles 5-95 de los valores. */
+export function makeScale(values: number[], opts: { log?: boolean; diverging?: boolean } = {}): Scale {
+  const log = Boolean(opts.log) && values.every((v) => v > 0);
+  const xs = values.filter((v) => Number.isFinite(v) && (!log || v > 0)).map((v) => (log ? Math.log10(v) : v));
+  xs.sort((a, b) => a - b);
+  const q = (p: number) => (xs.length ? xs[Math.min(xs.length - 1, Math.max(0, Math.floor(p * (xs.length - 1))))] : 0);
+  let lo = q(0.05);
+  let hi = q(0.95);
+  if (opts.diverging) {
+    const m = Math.max(Math.abs(lo), Math.abs(hi)) || 1;
+    lo = -m;
+    hi = m;
+  }
+  if (hi === lo) hi = lo + 1;
+  return {
+    lo: log ? 10 ** lo : lo,
+    hi: log ? 10 ** hi : hi,
+    log,
+    diverging: Boolean(opts.diverging),
+    color: (v) => {
+      if (v === null || !Number.isFinite(v) || (log && v <= 0)) return null;
+      const x = log ? Math.log10(v) : v;
+      return ramp(opts.diverging ? DIV : SEQ, (x - lo) / (hi - lo));
+    },
+  };
+}
+
+export function legendStops(diverging: boolean): string[] {
+  return diverging ? DIV : SEQ;
+}
+
+/** Capas cuyo valor conviene en escala logarítmica (muy sesgadas entre países). */
+export const LOG_LAYERS = new Set(["gdp_pc", "population", "co2", "primary_energy"]);
+/** Capas con signo, en escala divergente alrededor de 0. */
+export const DIVERGING_LAYERS = new Set(["growth", "net_rents"]);
+
+/** Crecimiento del PIB per cápita (p50 contra el año anterior), % por año; año 0 = null. */
+export function growthGrid(l1: World4L1): (number | null)[][] {
+  const s = l1.series.gdp_pc as CountrySeries | undefined;
+  if (!s) return [];
+  return l1.countries.map((_, i) =>
+    l1.years.map((_, k) => {
+      if (k === 0) return null;
+      const a = centralValue(s, i, k - 1);
+      const b = centralValue(s, i, k);
+      return a && b ? (b / a - 1) * 100 : null;
+    }),
+  );
+}
+
+export function fmt(v: number | null | undefined, digits = 3): string {
+  if (v === null || v === undefined || !Number.isFinite(v)) return "—";
+  const a = Math.abs(v);
+  if (a !== 0 && (a >= 1e6 || a < 1e-3)) return v.toExponential(2);
+  if (a >= 1000) return Math.round(v).toLocaleString("en-US");
+  return Number(v.toPrecision(digits)).toString();
+}
+
+export function pct(v: number | null | undefined): string {
+  if (v === null || v === undefined || !Number.isFinite(v)) return "—";
+  return `${Math.round(v * 100)} %`;
+}
