+            </div>
+          );
+        })}
+      </div>
+      <span style={{ ...monoStyle, fontSize: "10px", color: "var(--ink-dim)" }}>{l1.flows.unit}</span>
+
+      <div className="flex flex-wrap gap-2">
+        <button type="button" onClick={() => onAsk({ target: "quo", iso3: c.iso3, name })}
+          className="rounded-md px-3 py-1.5" style={{ background: "var(--electric)", color: "#0A0E14", fontFamily: "var(--quasar-font-mono)", fontSize: "12px" }}>
+          {t("world4.agent.askQuo", { name })}
+        </button>
+        <button type="button" onClick={() => onAsk({ target: "pr", iso3: c.iso3, name })}
+          className="rounded-md px-3 py-1.5" style={{ background: "transparent", color: "var(--ink-primary)", border: "1px solid rgba(255,255,255,0.18)", fontFamily: "var(--quasar-font-mono)", fontSize: "12px" }}>
+          {t("world4.agent.askPr")}
+        </button>
+      </div>
+    </div>
+  );
+}
