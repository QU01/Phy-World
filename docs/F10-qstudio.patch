+++ b/frontend/src/components/world4/Globe3D.tsx
@@ -0,0 +1,545 @@
+"use client";
+
+// Globo 3D del explorador de World4 (F10). three.js puro (ya es dependencia de Studio), sin globe.gl:
+//
+//   · los países se pintan en un CANVAS equirectangular que es la textura de la esfera: recolorear por capa
+//     o año es redibujar 177 polígonos, no retriangular nada en la esfera;
+//   · los flujos (comercio, drenaje) son arcos de círculo máximo elevados, en UN LineSegments con color por
+//     vértice y mezcla aditiva, más partículas que viajan por ellos (sentido = origen → destino);
+//   · los agentes son UN Points con shader propio: disco por país y anillo que late cuando hay evento;
+//   · la selección es un raycast a la esfera → uv → lon/lat → punto en polígono.
+//
+// Convención (la de SphereGeometry): u = (lon + 180) / 360, v = (90 - lat) / 180, con el canvas arriba = norte.
+
+import { useEffect, useRef } from "react";
+import * as THREE from "three";
+import { OrbitControls } from "three/addons/controls/OrbitControls.js";
+
+import type { GeoFeature } from "@/lib/world4";
+
+export interface GlobeArc {
+  a: [number, number];
+  b: [number, number];
+  /** Peso 0-1 (valor relativo al mayor del año). */
+  w: number;
+  color: string;
+}
+
+export interface GlobeAgent {
+  lon: number;
+  lat: number;
+  /** Tamaño relativo 0-1. */
+  size: number;
+  color: string;
+  /** 0 = sin evento; > 0 = anillo que late. */
+  pulse: number;
+  feature: number;
+}
+
+export interface Globe3DProps {
+  features: GeoFeature[];
+  fills: (string | null)[];
+  selected: number | null;
+  arcs: GlobeArc[];
+  agents: GlobeAgent[];
+  autoRotate: boolean;
+  onPick: (feature: number | null) => void;
+  onHover: (feature: number | null, x: number, y: number) => void;
+  onError?: (message: string) => void;
+  height?: number;
+}
+
+const TEX_W = 4096;
+const TEX_H = 2048;
+const OCEAN = "#0a1622";
+const NO_DATA = "rgba(120,135,150,0.35)";
+const ARC_SEGMENTS = 48;
+const PARTICLES_PER_ARC = 2;
+
+export function lonLatToVec3(lon: number, lat: number, r = 1): THREE.Vector3 {
+  const phi = ((lon + 180) / 360) * Math.PI * 2;
+  const theta = ((90 - lat) / 180) * Math.PI;
+  return new THREE.Vector3(-Math.cos(phi) * Math.sin(theta) * r, Math.cos(theta) * r, Math.sin(phi) * Math.sin(theta) * r);
+}
+
+// ── geometría de los países ──────────────────────────────────────────────────
+
+type Ring = [number, number][];
+interface Prepared {
+  polys: Ring[][]; // polígono → anillos (el 0 es el exterior) con longitudes desenrolladas
+  bbox: [number, number, number, number];
+}
+
+function unwrap(ring: number[][]): Ring {
+  const out: Ring = [];
+  let prev = ring[0]?.[0] ?? 0;
+  for (const [lon0, lat] of ring) {
+    let lon = lon0;
+    while (lon - prev > 180) lon -= 360;
+    while (lon - prev < -180) lon += 360;
+    out.push([lon, lat]);
+    prev = lon;
+  }
+  return out;
+}
+
+function prepare(f: GeoFeature): Prepared {
+  const polys = (f.geometry.type === "Polygon" ? [f.geometry.coordinates] : f.geometry.coordinates).map((p) =>
+    p.map((r) => unwrap(r)),
+  );
+  let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
+  for (const p of polys) for (const [x, y] of p[0] ?? []) {
+    x0 = Math.min(x0, x); x1 = Math.max(x1, x); y0 = Math.min(y0, y); y1 = Math.max(y1, y);
+  }
+  return { polys, bbox: [x0, y0, x1, y1] };
+}
+
+function inRing(x: number, y: number, ring: Ring): boolean {
+  let inside = false;
+  for (let i = 0, j = ring.length - 1; i < ring.length; j = i++) {
+    const [xi, yi] = ring[i];
+    const [xj, yj] = ring[j];
+    if (yi > y !== yj > y && x < ((xj - xi) * (y - yi)) / (yj - yi + 1e-12) + xi) inside = !inside;
+  }
+  return inside;
+}
+
+function pick(prep: Prepared[], lon: number, lat: number): number | null {
+  for (let k = 0; k < prep.length; k++) {
+    const { polys, bbox } = prep[k];
+    for (const x of [lon, lon - 360, lon + 360]) {
+      if (x < bbox[0] || x > bbox[2] || lat < bbox[1] || lat > bbox[3]) continue;
+      for (const p of polys) {
+        if (!p[0] || !inRing(x, lat, p[0])) continue;
+        if (p.slice(1).some((hole) => inRing(x, lat, hole))) continue;
+        return k;
+      }
+    }
+  }
+  return null;
+}
+
+function drawTexture(ctx: CanvasRenderingContext2D, prep: Prepared[], fills: (string | null)[], selected: number | null) {
+  ctx.fillStyle = OCEAN;
+  ctx.fillRect(0, 0, TEX_W, TEX_H);
+  // retícula cada 30°
+  ctx.strokeStyle = "rgba(92,200,232,0.07)";
+  ctx.lineWidth = 2;
+  for (let lon = -180; lon <= 180; lon += 30) {
+    const x = ((lon + 180) / 360) * TEX_W;
+    ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, TEX_H); ctx.stroke();
+  }
+  for (let lat = -60; lat <= 60; lat += 30) {
+    const y = ((90 - lat) / 180) * TEX_H;
+    ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(TEX_W, y); ctx.stroke();
+  }
+  const trace = (k: number) => {
+    const { polys, bbox } = prep[k];
+    ctx.beginPath();
+    for (const off of [-360, 0, 360]) {
+      if (bbox[2] + off < -180 || bbox[0] + off > 180) continue;
+      for (const p of polys) for (const ring of p) {
+        ring.forEach(([lon, lat], i) => {
+          const x = ((lon + off + 180) / 360) * TEX_W;
+          const y = ((90 - lat) / 180) * TEX_H;
+          if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
+        });
+        ctx.closePath();
+      }
+    }
+  };
+  for (let k = 0; k < prep.length; k++) {
+    trace(k);
+    ctx.fillStyle = fills[k] ?? NO_DATA;
+    ctx.fill("evenodd");
+    ctx.strokeStyle = "rgba(10,22,34,0.85)";
+    ctx.lineWidth = 2.2;
+    ctx.stroke();
+  }
+  if (selected !== null && prep[selected]) {
+    trace(selected);
+    ctx.strokeStyle = "#F5F7FA";
+    ctx.lineWidth = 7;
+    ctx.stroke();
+  }
+}
+
+// ── arcos ────────────────────────────────────────────────────────────────────
+
+function arcPoints(a: [number, number], b: [number, number]): THREE.Vector3[] {
+  const va = lonLatToVec3(a[0], a[1]);
+  const vb = lonLatToVec3(b[0], b[1]);
+  const ang = va.angleTo(vb);
+  const lift = 0.04 + 0.32 * (ang / Math.PI);
+  const pts: THREE.Vector3[] = [];
+  const q = new THREE.Quaternion();
+  const axis = new THREE.Vector3().crossVectors(va, vb).normalize();
+  for (let i = 0; i <= ARC_SEGMENTS; i++) {
+    const t = i / ARC_SEGMENTS;
+    q.setFromAxisAngle(axis.lengthSq() > 0 ? axis : new THREE.Vector3(0, 1, 0), ang * t);
+    const p = va.clone().applyQuaternion(q);
+    pts.push(p.multiplyScalar(1.004 + lift * Math.sin(Math.PI * t)));
+  }
+  return pts;
+}
+
+const AGENT_VERT = `
+attribute float aSize; attribute vec3 aColor; attribute float aPulse;
+uniform float uScale;
+varying vec3 vColor; varying float vPulse;
+void main() {
+  vColor = aColor; vPulse = aPulse;
+  vec4 mv = modelViewMatrix * vec4(position, 1.0);
+  float s = aSize * (aPulse > 0.0 ? 3.0 : 1.0);
+  gl_PointSize = s * uScale / -mv.z;
+  gl_Position = projectionMatrix * mv;
+}`;
+
+const AGENT_FRAG = `
+uniform float uTime;
+varying vec3 vColor; varying float vPulse;
+void main() {
+  vec2 c = gl_PointCoord - 0.5;
+  float d = length(c);
+  float coreR = vPulse > 0.0 ? 0.5 / 3.0 : 0.5;
+  float core = 1.0 - smoothstep(coreR * 0.55, coreR, d);
+  float alpha = core * 0.95;
+  vec3 col = vColor;
+  if (vPulse > 0.0) {
+    float ph = fract(uTime * 0.7 + vPulse * 0.37);
+    float r = coreR + ph * (0.5 - coreR);
+    float ring = (1.0 - smoothstep(0.0, 0.035, abs(d - r))) * (1.0 - ph);
+    col = mix(col, vec3(0.97, 0.36, 0.30), ring);
+    alpha = max(alpha, ring * 0.9);
+  }
+  if (alpha < 0.02) discard;
+  gl_FragColor = vec4(col, alpha);
+}`;
+
+const GLOW_VERT = `
+varying vec3 vNormal;
+void main() { vNormal = normalize(normalMatrix * normal); gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0); }`;
+const GLOW_FRAG = `
+varying vec3 vNormal;
+void main() { float i = pow(0.72 - dot(vNormal, vec3(0.0, 0.0, 1.0)), 2.2); gl_FragColor = vec4(0.23, 0.63, 1.0, 1.0) * i; }`;
+
+interface SceneState {
+  renderer: THREE.WebGLRenderer;
+  scene: THREE.Scene;
+  camera: THREE.PerspectiveCamera;
+  controls: OrbitControls;
+  globe: THREE.Mesh;
+  canvas: HTMLCanvasElement;
+  ctx: CanvasRenderingContext2D;
+  texture: THREE.CanvasTexture;
+  arcs: THREE.LineSegments | null;
+  particles: THREE.Points | null;
+  particlePaths: { pts: THREE.Vector3[]; offset: number; speed: number }[];
+  agents: THREE.Points | null;
+  agentMat: THREE.ShaderMaterial;
+  frame: number;
+  visible: boolean;
+}
+
+export function Globe3D({ features, fills, selected, arcs, agents, autoRotate, onPick, onHover, onError, height = 560 }: Globe3DProps) {
+  const hostRef = useRef<HTMLDivElement | null>(null);
+  const stateRef = useRef<SceneState | null>(null);
+  const prepRef = useRef<Prepared[]>([]);
+  const cbRef = useRef({ onPick, onHover, onError });
+  useEffect(() => {
+    cbRef.current = { onPick, onHover, onError };
+  }, [onPick, onHover, onError]);
+
+  // Escena: una vez por montaje.
+  useEffect(() => {
+    const host = hostRef.current;
+    if (!host) return;
+    let renderer: THREE.WebGLRenderer;
+    try {
+      renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
+    } catch (e) {
+      cbRef.current.onError?.(String(e));
+      return;
+    }
+    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
+    renderer.setSize(host.clientWidth, height);
+    renderer.outputColorSpace = THREE.SRGBColorSpace;
+    host.appendChild(renderer.domElement);
+    renderer.domElement.style.display = "block";
+    renderer.domElement.style.cursor = "grab";
+
+    const scene = new THREE.Scene();
+    const camera = new THREE.PerspectiveCamera(38, host.clientWidth / height, 0.05, 100);
+    camera.position.copy(lonLatToVec3(15, 22, 3.3));
+    const controls = new OrbitControls(camera, renderer.domElement);
+    controls.enableDamping = true;
+    controls.dampingFactor = 0.08;
+    controls.minDistance = 1.35;
+    controls.maxDistance = 5;
+    controls.enablePan = false;
+    controls.rotateSpeed = 0.55;
+    controls.autoRotateSpeed = 0.35;
+
+    scene.add(new THREE.AmbientLight(0xffffff, 1.6));
+    const sun = new THREE.DirectionalLight(0xffffff, 1.1);
+    camera.add(sun);
+    sun.position.set(-1.5, 1.2, 1);
+    scene.add(camera);
+
+    const canvas = document.createElement("canvas");
+    canvas.width = TEX_W;
+    canvas.height = TEX_H;
+    const ctx = canvas.getContext("2d") as CanvasRenderingContext2D;
+    const texture = new THREE.CanvasTexture(canvas);
+    texture.colorSpace = THREE.SRGBColorSpace;
+    texture.anisotropy = Math.min(8, renderer.capabilities.getMaxAnisotropy());
+    const globe = new THREE.Mesh(
+      new THREE.SphereGeometry(1, 128, 96),
+      new THREE.MeshStandardMaterial({ map: texture, roughness: 0.95, metalness: 0.0 }),
+    );
+    scene.add(globe);
+    const glow = new THREE.Mesh(
+      new THREE.SphereGeometry(1.09, 64, 48),
+      new THREE.ShaderMaterial({ vertexShader: GLOW_VERT, fragmentShader: GLOW_FRAG, side: THREE.BackSide,
+        blending: THREE.AdditiveBlending, transparent: true, depthWrite: false }),
+    );
+    scene.add(glow);
+    // cielo de estrellas
+    const starPos = new Float32Array(1800 * 3);
+    for (let i = 0; i < 1800; i++) {
+      const v = new THREE.Vector3().randomDirection().multiplyScalar(30 + Math.random() * 20);
+      starPos.set([v.x, v.y, v.z], i * 3);
+    }
+    const starGeo = new THREE.BufferGeometry();
+    starGeo.setAttribute("position", new THREE.BufferAttribute(starPos, 3));
+    scene.add(new THREE.Points(starGeo, new THREE.PointsMaterial({ color: 0x8fb4d8, size: 0.08, transparent: true, opacity: 0.55 })));
+
+    const agentMat = new THREE.ShaderMaterial({
+      vertexShader: AGENT_VERT, fragmentShader: AGENT_FRAG, transparent: true, depthWrite: false,
+      uniforms: { uTime: { value: 0 }, uScale: { value: 3.2 * renderer.getPixelRatio() } },
+    });
+
+    const st: SceneState = { renderer, scene, camera, controls, globe, canvas, ctx, texture, arcs: null, particles: null,
+      particlePaths: [], agents: null, agentMat, frame: 0, visible: true };
+    stateRef.current = st;
+
+    // ── interacción ────────────────────────────────────────────────────────
+    const ray = new THREE.Raycaster();
+    const ndc = new THREE.Vector2();
+    const featureAt = (ev: PointerEvent): number | null => {
+      const r = renderer.domElement.getBoundingClientRect();
+      ndc.set(((ev.clientX - r.left) / r.width) * 2 - 1, -((ev.clientY - r.top) / r.height) * 2 + 1);
+      ray.setFromCamera(ndc, camera);
+      const hit = ray.intersectObject(globe, false)[0];
+      if (!hit?.uv) return null;
+      return pick(prepRef.current, hit.uv.x * 360 - 180, hit.uv.y * 180 - 90);
+    };
+    let down: { x: number; y: number } | null = null;
+    let hoverQueued = false;
+    const onDown = (e: PointerEvent) => { down = { x: e.clientX, y: e.clientY }; renderer.domElement.style.cursor = "grabbing"; };
+    const onUp = (e: PointerEvent) => {
+      renderer.domElement.style.cursor = "grab";
+      if (down && Math.hypot(e.clientX - down.x, e.clientY - down.y) < 5) cbRef.current.onPick(featureAt(e));
+      down = null;
+    };
+    const onMove = (e: PointerEvent) => {
+      if (hoverQueued || down) return;
+      hoverQueued = true;
+      requestAnimationFrame(() => {
+        hoverQueued = false;
+        const r = renderer.domElement.getBoundingClientRect();
+        cbRef.current.onHover(featureAt(e), e.clientX - r.left, e.clientY - r.top);
+      });
+    };
+    const onLeave = () => cbRef.current.onHover(null, 0, 0);
+    renderer.domElement.addEventListener("pointerdown", onDown);
+    renderer.domElement.addEventListener("pointerup", onUp);
+    renderer.domElement.addEventListener("pointermove", onMove);
+    renderer.domElement.addEventListener("pointerleave", onLeave);
+
+    const resize = () => {
+      const w = host.clientWidth;
+      renderer.setSize(w, height);
+      camera.aspect = w / height;
+      camera.updateProjectionMatrix();
+    };
+    const ro = new ResizeObserver(resize);
+    ro.observe(host);
+    const io = new IntersectionObserver(([entry]) => { st.visible = entry.isIntersecting; });
+    io.observe(host);
+
+    const clock = new THREE.Clock();
+    const tick = () => {
+      st.frame = requestAnimationFrame(tick);
+      if (!st.visible || document.hidden) return;
+      const t = clock.getElapsedTime();
+      controls.update();
+      agentMat.uniforms.uTime.value = t;
+      const P = st.particles;
+      if (P) {
+        const pos = P.geometry.getAttribute("position") as THREE.BufferAttribute;
+        st.particlePaths.forEach((path, i) => {
+          const u = (t * path.speed + path.offset) % 1;
+          const x = u * ARC_SEGMENTS;
+          const k = Math.min(Math.floor(x), ARC_SEGMENTS - 1);
+          const a = path.pts[k], b = path.pts[k + 1];
+          const f = x - k;
+          pos.setXYZ(i, a.x + (b.x - a.x) * f, a.y + (b.y - a.y) * f, a.z + (b.z - a.z) * f);
+        });
+        pos.needsUpdate = true;
+      }
+      renderer.render(scene, camera);
+    };
+    tick();
+
+    return () => {
+      cancelAnimationFrame(st.frame);
+      ro.disconnect();
+      io.disconnect();
+      renderer.domElement.removeEventListener("pointerdown", onDown);
+      renderer.domElement.removeEventListener("pointerup", onUp);
+      renderer.domElement.removeEventListener("pointermove", onMove);
+      renderer.domElement.removeEventListener("pointerleave", onLeave);
+      controls.dispose();
+      scene.traverse((o) => {
+        const m = o as THREE.Mesh;
+        m.geometry?.dispose?.();
+        const mat = m.material as THREE.Material | THREE.Material[] | undefined;
+        if (Array.isArray(mat)) mat.forEach((x) => x.dispose()); else mat?.dispose?.();
+      });
+      texture.dispose();
+      renderer.dispose();
+      renderer.domElement.remove();
+      stateRef.current = null;
+    };
+  }, [height]);
+
+  // Geometría preparada (una vez por conjunto de países).
+  useEffect(() => {
+    prepRef.current = features.map(prepare);
+  }, [features]);
+
+  // Textura: capa, año o selección.
+  useEffect(() => {
+    const st = stateRef.current;
+    if (!st || prepRef.current.length !== features.length) {
+      prepRef.current = features.map(prepare);
+    }
+    if (!st) return;
+    drawTexture(st.ctx, prepRef.current, fills, selected);
+    st.texture.needsUpdate = true;
+  }, [features, fills, selected]);
+
+  // Arcos y partículas.
+  useEffect(() => {
+    const st = stateRef.current;
+    if (!st) return;
+    for (const o of [st.arcs, st.particles]) {
+      if (!o) continue;
+      st.scene.remove(o);
+      o.geometry.dispose();
+      (o.material as THREE.Material).dispose();
+    }
+    st.arcs = null;
+    st.particles = null;
+    st.particlePaths = [];
+    if (!arcs.length) return;
+    const pos: number[] = [];
+    const col: number[] = [];
+    const ppos: number[] = [];
+    const pcol: number[] = [];
+    const c = new THREE.Color();
+    arcs.forEach((arc, n) => {
+      const pts = arcPoints(arc.a, arc.b);
+      c.set(arc.color);
+      const k = 0.18 + 0.82 * arc.w;
+      for (let i = 0; i < ARC_SEGMENTS; i++) {
+        const [p, q] = [pts[i], pts[i + 1]];
+        // degradado a lo largo del arco: más brillante hacia el destino
+        const f0 = k * (0.35 + 0.65 * (i / ARC_SEGMENTS));
+        const f1 = k * (0.35 + 0.65 * ((i + 1) / ARC_SEGMENTS));
+        pos.push(p.x, p.y, p.z, q.x, q.y, q.z);
+        col.push(c.r * f0, c.g * f0, c.b * f0, c.r * f1, c.g * f1, c.b * f1);
+      }
+      for (let j = 0; j < PARTICLES_PER_ARC; j++) {
+        st.particlePaths.push({ pts, offset: (j / PARTICLES_PER_ARC + n * 0.137) % 1, speed: 0.12 + 0.1 * arc.w });
+        ppos.push(0, 0, 0);
+        pcol.push(c.r, c.g, c.b);
+      }
+    });
+    const g = new THREE.BufferGeometry();
+    g.setAttribute("position", new THREE.Float32BufferAttribute(pos, 3));
+    g.setAttribute("color", new THREE.Float32BufferAttribute(col, 3));
+    st.arcs = new THREE.LineSegments(g, new THREE.LineBasicMaterial({ vertexColors: true, transparent: true,
+      blending: THREE.AdditiveBlending, depthWrite: false }));
+    st.scene.add(st.arcs);
+    const pg = new THREE.BufferGeometry();
+    pg.setAttribute("position", new THREE.Float32BufferAttribute(ppos, 3));
+    pg.setAttribute("color", new THREE.Float32BufferAttribute(pcol, 3));
+    st.particles = new THREE.Points(pg, new THREE.PointsMaterial({ size: 0.022, vertexColors: true, transparent: true,
+      blending: THREE.AdditiveBlending, depthWrite: false, sizeAttenuation: true }));
+    st.scene.add(st.particles);
+  }, [arcs]);
+
+  // Agentes.
+  useEffect(() => {
+    const st = stateRef.current;
+    if (!st) return;
+    if (st.agents) {
+      st.scene.remove(st.agents);
+      st.agents.geometry.dispose();
+      st.agents = null;
+    }
+    if (!agents.length) return;
+    const pos = new Float32Array(agents.length * 3);
+    const col = new Float32Array(agents.length * 3);
+    const size = new Float32Array(agents.length);
+    const pulse = new Float32Array(agents.length);
+    const c = new THREE.Color();
+    agents.forEach((a, i) => {
+      const v = lonLatToVec3(a.lon, a.lat, 1.006);
+      pos.set([v.x, v.y, v.z], i * 3);
+      c.set(a.feature === selected ? "#F5F7FA" : a.color);
+      col.set([c.r, c.g, c.b], i * 3);
+      size[i] = (a.feature === selected ? 1.5 : 1) * (3 + 10 * Math.sqrt(Math.max(a.size, 0)));
+      pulse[i] = a.pulse;
+    });
+    const g = new THREE.BufferGeometry();
+    g.setAttribute("position", new THREE.BufferAttribute(pos, 3));
+    g.setAttribute("aColor", new THREE.BufferAttribute(col, 3));
+    g.setAttribute("aSize", new THREE.BufferAttribute(size, 1));
+    g.setAttribute("aPulse", new THREE.BufferAttribute(pulse, 1));
+    st.agents = new THREE.Points(g, st.agentMat);
+    st.scene.add(st.agents);
+  }, [agents, selected]);
+
+  useEffect(() => {
+    const st = stateRef.current;
+    if (st) st.controls.autoRotate = autoRotate;
+  }, [autoRotate]);
+
+  // Girar hacia el país elegido.
+  useEffect(() => {
+    const st = stateRef.current;
+    const f = selected !== null ? features[selected] : null;
+    if (!st || !f) return;
+    const [lon, lat] = f.properties.centroid;
+    const from = st.camera.position.clone();
+    const to = lonLatToVec3(lon, lat, from.length());
+    let k = 0;
+    let raf = 0;
+    const step = () => {
+      k = Math.min(k + 0.06, 1);
+      const e = 1 - (1 - k) ** 3;
+      st.camera.position.copy(from.clone().lerp(to, e).setLength(from.length()));
+      st.camera.lookAt(0, 0, 0);
+      if (k < 1) raf = requestAnimationFrame(step);
+    };
+    step();
+    return () => cancelAnimationFrame(raf);
+  }, [selected, features]);
+
+  return <div ref={hostRef} style={{ width: "100%", height, position: "relative" }} />;
+}
+
+export default Globe3D;
