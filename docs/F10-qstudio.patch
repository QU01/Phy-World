+              <span style={{ ...monoStyle, fontSize: "11px", color: e.kind === "conflict" ? "var(--error)" : "var(--warning)" }}>
+                {t(`world4.pulse.event${e.kind[0].toUpperCase()}${e.kind.slice(1)}`, { p: pct(e.p) })}
