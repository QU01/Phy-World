+      const now = l1.channels.share[i]?.[k];
+      const before = l1.channels.share[i]?.[k - 1];
+      if (!now || !before) return null;
+      let best: { ch: string; d: number } | null = null;
+      channelNames.forEach((c, j) => {
+        const a = before[j], b = now[j];
+        if (typeof a !== "number" || typeof b !== "number") return;
+        const d = b - a;
+        if (Math.abs(d) >= MOVE_MIN && (!best || Math.abs(d) > Math.abs(best.d))) best = { ch: c, d };
+      });
+      return best;
+    },
+    [l1, channelNames],
+  );
+  const eventsOf = useCallback(
+    (i: number, k: number) => {
+      if (!l1) return [] as { kind: keyof typeof EVENT_THRESHOLDS; p: number }[];
+      const out: { kind: keyof typeof EVENT_THRESHOLDS; p: number }[] = [];
+      for (const kind of Object.keys(EVENT_THRESHOLDS) as (keyof typeof EVENT_THRESHOLDS)[]) {
+        const s = l1.series[kind];
+        const v = s ? centralValue(s, i, k) : null;
+        if (v !== null && v >= EVENT_THRESHOLDS[kind]) out.push({ kind, p: v });
+      }
+      return out;
+    },
+    [l1],
+  );
