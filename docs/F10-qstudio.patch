+import { AskPanel } from "./AskPanel";
+import { GlobeView, type AskTarget } from "./GlobeView";
+import { RunGraph } from "./RunGraph";
+
+type Tab = "globe" | "graph" | "ask";
+
+export function WorldExplorer({ modelId, run }: { slot?: PhySlot; modelId: string; run: PhyRunSnapshot | null }) {
+  const t = useT();
+  const [runs, setRuns] = useState<PhyRunSnapshot[]>([]);
+  const [runId, setRunId] = useState<string | null>(null);
+  const [data, setData] = useState<World4RunData | null>(null);
+  const [state, setState] = useState<"idle" | "loading" | "missing">("idle");
+  const [tab, setTab] = useState<Tab>("globe");
+  const [focus, setFocus] = useState<AskTarget | null>(null);
+  const [tick, setTick] = useState(0);
+
+  // la lista de corridas terminadas (y la de la vista cuando termina)
+  useEffect(() => {
+    let alive = true;
+    void listWorld4Runs(modelId).then((rs) => {
+      if (!alive) return;
+      setRuns(rs);
+      setRunId((cur) => cur ?? rs[0]?.run_id ?? null);
+    });
+    return () => { alive = false; };
+  }, [modelId, tick, run?.status]);
+  useEffect(() => {
+    if (run?.status === "done") void Promise.resolve().then(() => setRunId(run.run_id));
+  }, [run?.run_id, run?.status]);
+
+  useEffect(() => {
+    if (!runId) return;
+    let alive = true;
+    void Promise.resolve().then(() => alive && setState("loading"));
+    void loadWorld4Run(modelId, runId).then((d) => {
+      if (!alive) return;
+      setData(d);
+      setState(d ? "idle" : "missing");
+    });
+    return () => { alive = false; };
+  }, [modelId, runId]);
+
+  const snap = runs.find((r) => r.run_id === runId) ?? (run?.run_id === runId ? run : null);
+  const family = String(snap?.family ?? snap?.config?.family ?? "scenario");
+  const fidelity = String(snap?.fidelity ?? "L0");
+  const onAsk = useCallback((target: AskTarget) => {
+    setFocus(target);
+    setTab("ask");
+  }, []);
+
+  const runLabel = (r: PhyRunSnapshot) =>
+    t("world4.runLabel", {
+      family: String(r.family ?? r.config?.family ?? "scenario"), fidelity: String(r.fidelity ?? ""),
+      narrative: String(r.config?.narrative ?? "ssp2"), date: String(r.created_at ?? "").slice(0, 16).replace("T", " "),
+    });
+
+  const tabs: { id: Tab; label: string; icon: React.ReactNode }[] = [
+    { id: "globe", label: t("world4.tabs.globe"), icon: <Globe2 size={14} /> },
+    { id: "graph", label: t("world4.tabs.graph"), icon: <Workflow size={14} /> },
+    { id: "ask", label: t("world4.tabs.ask"), icon: <MessageSquareText size={14} /> },
+  ];
+
+  return (
+    <Panel>
+      <div className="flex flex-wrap items-start justify-between gap-3">
+        <div className="flex flex-col gap-1">
+          <div className="flex flex-wrap items-center gap-2">
+            <h2 style={{ fontFamily: "var(--quasar-font-display)", fontSize: "20px", fontWeight: 600, color: "var(--ink-primary)" }}>
+              {t("world4.title")}
+            </h2>
+            <Badge tone="warn">{t("world4.badges.exploratory")}</Badge>
+            {data && !data.world.l1 ? <Badge tone="dim">{t("world4.badges.l0only")}</Badge> : null}
+            {data?.world.l1 ? <Badge tone="dim">{t("world4.badges.members", { n: data.world.l1.members })}</Badge> : null}
+            {data ? <Badge tone="dim">{t("world4.badges.states", { n: data.world.l0.members })}</Badge> : null}
+          </div>
+          <span style={{ ...monoStyle, fontSize: "12px" }}>{t("world4.subtitle")}</span>
+        </div>
+        <div className="flex items-center gap-2">
+          <label className="flex items-center gap-2">
+            <span style={labelStyle}>{t("world4.run")}</span>
+            <select value={runId ?? ""} onChange={(e) => setRunId(e.target.value || null)} disabled={!runs.length}
+              style={{ fontFamily: "var(--quasar-font-mono)", fontSize: "12px", color: "var(--ink-primary)", background: "var(--surface-0)",
+                border: "1px solid rgba(255,255,255,0.12)", borderRadius: 6, padding: "5px 8px", maxWidth: 360 }}>
+              {runs.map((r) => <option key={r.run_id} value={r.run_id}>{runLabel(r)}</option>)}
+            </select>
+          </label>
+          <button type="button" onClick={() => setTick((k) => k + 1)} aria-label={t("world4.refresh")} title={t("world4.refresh")}
+            className="flex h-8 w-8 items-center justify-center rounded-md" style={{ border: "1px solid rgba(255,255,255,0.12)", color: "var(--ink-muted)" }}>
+            <RefreshCw size={14} />
+          </button>
+        </div>
+      </div>
+
+      <span style={{ ...monoStyle, fontSize: "11px", color: "var(--warning)" }}>{t("world4.honesty")}</span>
+
+      {!runs.length && !runId ? (
+        <Notice tone="info">{t("world4.noRuns")}</Notice>
+      ) : state === "loading" && !data ? (
+        <span style={{ ...monoStyle, fontSize: "12px" }}>{t("world4.loading")}</span>
+      ) : state === "missing" ? (
+        <Notice tone="warn">{t("world4.missing")}</Notice>
+      ) : data ? (
+        <>
+          <div role="tablist" aria-label={t("world4.tabs.label")} className="flex gap-1 border-b" style={{ borderColor: "rgba(255,255,255,0.08)" }}>
+            {tabs.map((x) => (
+              <button key={x.id} type="button" role="tab" aria-selected={tab === x.id} onClick={() => setTab(x.id)}
+                className="flex items-center gap-1.5 px-3 py-2"
+                style={{ fontFamily: "var(--quasar-font-mono)", fontSize: "12px", color: tab === x.id ? "var(--ink-primary)" : "var(--ink-dim)",
+                  borderBottom: `2px solid ${tab === x.id ? "var(--electric)" : "transparent"}`, marginBottom: -1 }}>
+                {x.icon} {x.label}
+              </button>
+            ))}
+          </div>
+          <div role="tabpanel" style={{ display: tab === "globe" ? "block" : "none" }}>
+            <GlobeView key={data.runId} data={data} onAsk={onAsk} />
+          </div>
+          {tab === "graph" ? <RunGraph data={data} /> : null}
+          {tab === "ask" ? <AskPanel data={data} family={family} fidelity={fidelity} focus={focus} /> : null}
+        </>
+      ) : null}
+    </Panel>
+  );
+}
+
+export default WorldExplorer;
