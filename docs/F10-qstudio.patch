+"use client";
+
+// Pestaña "Globe" del explorador de World4: el globo 3D con la capa elegida, los flujos y los agentes, una
+// línea de tiempo con reproducción, y a la derecha el pulso del mundo o la ficha del país-agente elegido.
+
+import { useCallback, useEffect, useMemo, useState } from "react";
+import { Pause, Play, X } from "lucide-react";
+
+import { useT } from "@/lib/i18n";
+import {
+  centralValue,
+  isFrequency,
+  type CountrySeries,
+  type GeoFeature,
+  type QuantileSeries,
+  type World4RunData,
+} from "@/lib/world4";
+import { Badge, labelStyle, monoStyle, Notice } from "@/components/phy/ui";
+
+import { BandSparkline, DecisionColumns } from "./charts";
+import { Globe3D, type GlobeAgent, type GlobeArc } from "./Globe3D";
+import {
+  CHANNEL_COLORS,
+  DIVERGING_LAYERS,
+  FLOW_COLORS,
+  LOG_LAYERS,
+  fmt,
+  growthGrid,
+  legendStops,
+  makeScale,
+  pct,
+} from "./scales";
+
+/** "+1,2 pp hacia X" / "−1,2 pp desde X": el sentido del cambio de reparto del agente. */
+function shiftText(t: ReturnType<typeof useT>, mv: { ch: string; d: number }): string {
+  return t(mv.d > 0 ? "world4.pulse.shiftIn" : "world4.pulse.shiftOut", {
+    pp: fmt(Math.abs(mv.d) * 100, 2), channel: t(`world4.channels.${mv.ch}`),
+  });
+}
+
+export interface AskTarget {
+  target: "quo" | "pr";
+  iso3?: string;
+  name?: string;
+}
+
+type FlowMode = "trade" | "drain" | "none";
+
+const L1_LAYER_ORDER = [
+  "gdp_pc", "growth", "population", "coreness", "asabiya", "debt_gdp", "democracy", "conflict_hazard", "conflict",
+  "crisis", "coup", "drain", "net_rents", "resource_rents", "co2", "primary_energy", "food_supply",
+];
+const L0_LAYERS = ["gdp_pc", "population", "debt_gdp", "cereal_pc", "nonfossil_share"] as const;
+const EVENT_THRESHOLDS = { conflict: 0.5, crisis: 0.25, coup: 0.1 } as const;
+const MOVE_MIN = 0.002; // 0,2 puntos de la renta: por debajo no se cuenta como decisión
+
+const selectStyle: React.CSSProperties = {
+  fontFamily: "var(--quasar-font-mono)", fontSize: "12px", color: "var(--ink-primary)",
+  background: "rgba(10,14,20,0.82)", border: "1px solid rgba(255,255,255,0.14)", borderRadius: "6px", padding: "4px 8px",
+};
+const chipStyle = (on: boolean): React.CSSProperties => ({
+  fontFamily: "var(--quasar-font-mono)", fontSize: "11px", padding: "3px 9px", borderRadius: "999px", cursor: "pointer",
+  color: on ? "var(--ink-primary)" : "var(--ink-dim)", background: on ? "rgba(58,160,255,0.18)" : "rgba(10,14,20,0.7)",
+  border: `1px solid ${on ? "rgba(58,160,255,0.55)" : "rgba(255,255,255,0.12)"}`,
+});
+
+export function GlobeView({ data, onAsk }: { data: World4RunData; onAsk: (t: AskTarget) => void }) {
+  const t = useT();
+  const { world, geo } = data;
+  const l1 = world.l1;
+  const features: GeoFeature[] = geo.features;
+  const years = l1 ? l1.years : world.l0.years;
+
+  const [layer, setLayer] = useState<string>("gdp_pc");
+  const [yearIdx, setYearIdx] = useState(0);
+  const [playing, setPlaying] = useState(false);
+  const [flowMode, setFlowMode] = useState<FlowMode>(l1 ? "drain" : "none");
+  const [flowTop, setFlowTop] = useState(80);
+  const [showAgents, setShowAgents] = useState(true);
+  const [autoRotate, setAutoRotate] = useState(true);
+  const [selected, setSelected] = useState<number | null>(null);
+  const [hover, setHover] = useState<{ f: number | null; x: number; y: number }>({ f: null, x: 0, y: 0 });
+  const [glError, setGlError] = useState<string | null>(null);
+
+  // reproducción
+  useEffect(() => {
+    if (!playing) return;
+    const id = window.setInterval(() => {
+      setYearIdx((k) => {
+        if (k + 1 >= years.length) {
+          setPlaying(false);
+          return k;
+        }
+        return k + 1;
+      });
+    }, l1 ? 900 : 140);
+    return () => window.clearInterval(id);
+  }, [playing, years.length, l1]);
+
+  // país del L1 (o región del L0) de cada feature, por isonum
+  const featureCountry = useMemo(() => {
+    const idx = new Map<number, number>();
+    (l1?.countries ?? []).forEach((c, i) => idx.set(c.isonum, i));
+    return features.map((f) => (idx.has(f.id) ? (idx.get(f.id) as number) : null));
+  }, [features, l1]);
+  const featureRegion = useMemo(() => {
+    const reg = new Map<number, string>();
+    for (const c of world.l0.countries ?? []) if (c.region) reg.set(c.isonum, c.region);
+    return features.map((f) => reg.get(f.id) ?? null);
+  }, [features, world.l0.countries]);
+  const nameOf = useCallback(
+    (iso3: string) => {
+      const c = l1?.countries.find((x) => x.iso3 === iso3) ?? world.l0.countries?.find((x) => x.iso3 === iso3);
+      const f = c ? features.find((g) => g.id === c.isonum) : undefined;
+      return f?.properties.name ?? iso3;
+    },
+    [features, l1, world.l0.countries],
+  );
+
+  const growth = useMemo(() => (l1 ? growthGrid(l1) : []), [l1]);
+
+  // capas disponibles
+  const layers = useMemo(() => {
+    if (l1) return L1_LAYER_ORDER.filter((k) => k === "growth" || l1.series[k]);
+    return [...L0_LAYERS];
+  }, [l1]);
+  const activeLayer = layers.includes(layer) ? layer : layers[0];
+  const layerName = (k: string) => t(l1 ? `world4.layers.${k}` : `world4.layers.l0_${k}`);
+  const layerUnit = (k: string): string => {
+    if (!l1) return (world.l0.regions[Object.keys(world.l0.regions)[0]]?.[k as (typeof L0_LAYERS)[number]]?.unit) ?? "";
+    if (k === "growth") return t("world4.globe.growthUnit");
+    return l1.series[k]?.unit ?? "";
+  };
+
+  // valor por país (índice L1) o región, año k
+  const valueAt = useCallback(
+    (f: number, k: number): number | null => {
+      if (l1) {
+        const i = featureCountry[f];
+        if (i === null) return null;
+        if (activeLayer === "growth") return growth[i]?.[k] ?? null;
+        const s = l1.series[activeLayer];
+        return s ? centralValue(s, i, k) : null;
+      }
+      const r = featureRegion[f];
+      const band = r ? world.l0.regions[r]?.[activeLayer as (typeof L0_LAYERS)[number]] : null;
+      const v = band?.p50?.[k];
+      return typeof v === "number" ? v : null;
+    },
+    [l1, featureCountry, featureRegion, activeLayer, growth, world.l0.regions],
+  );
+
+  const scale = useMemo(() => {
+    const vals: number[] = [];
+    for (let f = 0; f < features.length; f++)
+      for (let k = 0; k < years.length; k++) {
+        const v = valueAt(f, k);
+        if (v !== null) vals.push(v);
+      }
+    return makeScale(vals, { log: LOG_LAYERS.has(activeLayer), diverging: DIVERGING_LAYERS.has(activeLayer) });
+  }, [features.length, years.length, valueAt, activeLayer]);
+
+  const fills = useMemo(() => features.map((_, f) => scale.color(valueAt(f, yearIdx))), [features, scale, valueAt, yearIdx]);
+
+  // agentes
+  const channelNames = useMemo(() => l1?.channels.names ?? [], [l1]);
+  const moveOf = useCallback(
+    (i: number, k: number): { ch: string; d: number } | null => {
