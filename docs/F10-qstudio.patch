+++ b/frontend/src/components/world4/RunGraph.tsx
@@ -0,0 +1,373 @@
+"use client";
+
+// Pestaña "Run graph" del explorador de World4: dos grafos de @xyflow sobre `graph.json` de la corrida.
+//
+//   · Flujo de información: datos → sectores → agentes y flujos → L0 → palancas ⇄ búsqueda → objetivos y
+//     límites → Prime Radiant y QUO. Columnas por tipo de nodo; cada nodo con el número principal de ESTA
+//     corrida y su estado (ok / falta / no corrido / violado). Clic → ficha con métricas, trayectoria,
+//     salvedades y procedencia.
+//   · Lazos de realimentación: los stocks del L0 (vista mundial) en círculo, unidos por sus flujos; la década
+//     elige los lazos dominantes (Loops that Matter) y uno elegido se resalta sobre el grafo.
+
+import { useCallback, useMemo, useState } from "react";
+import {
+  Background,
+  Controls,
+  Handle,
+  MarkerType,
+  Position,
+  ReactFlow,
+  type Edge,
+  type Node,
+  type NodeProps,
+  type NodeTypes,
+} from "@xyflow/react";
+import "@xyflow/react/dist/style.css";
+
+import { useT } from "@/lib/i18n";
+import type { GraphNode, World4RunData } from "@/lib/world4";
+import { Badge, labelStyle, monoStyle, Notice } from "@/components/phy/ui";
+
+import { BandSparkline } from "./charts";
+import { fmt, pct } from "./scales";
+
+const KIND_COLUMN: Record<string, number> = {
+  data: 0, sector: 1, agents: 2, flows: 2, model: 3, policy: 3, search: 4, objectives: 4, constraints: 4, consumer: 5,
+};
+const KIND_COLOR: Record<string, string> = {
+  data: "#78909C", sector: "#5CC8E8", agents: "#3AA0FF", flows: "#f97316", model: "#a78bfa", policy: "#22C55E",
+  search: "#E23EC0", objectives: "#e5d36a", constraints: "#f59e0b", consumer: "#F5F7FA",
+};
+const STATUS_COLOR: Record<string, string> = {
+  ok: "var(--success)", missing: "var(--error)", skipped: "var(--ink-dim)", violated: "var(--warning)",
+};
+const COL_W = 250;
+const ROW_H = 118;
+const hidden = { opacity: 0, width: 1, height: 1, minWidth: 0, minHeight: 0, border: 0 };
+
+interface FlowNodeData extends Record<string, unknown> {
+  node: GraphNode;
+  label: string;
+  selected: boolean;
+  kindLabel: string;
+  statusLabel: string;
+}
+
+function FlowNode({ data }: NodeProps<Node<FlowNodeData>>) {
+  const n = data.node;
+  const color = KIND_COLOR[n.kind] ?? "#78909C";
+  const m = n.metrics.find((x) => x.value !== null);
+  return (
+    <div className="flex flex-col gap-1 rounded-lg px-3 py-2"
+      style={{ width: 210, background: "var(--surface-0)", border: `1px solid ${data.selected ? color : "rgba(255,255,255,0.10)"}`,
+        boxShadow: data.selected ? `0 0 0 2px ${color}55, 0 0 18px ${color}33` : "none", cursor: "pointer" }}>
+      <Handle type="target" position={Position.Left} style={hidden} />
+      <Handle type="source" position={Position.Right} style={hidden} />
+      <div className="flex items-center justify-between gap-2">
+        <span style={{ fontFamily: "var(--quasar-font-mono)", fontSize: "9px", letterSpacing: "0.1em", textTransform: "uppercase", color }}>{data.kindLabel}</span>
+        <span className="flex items-center gap-1" style={{ fontFamily: "var(--quasar-font-mono)", fontSize: "9px", color: "var(--ink-dim)" }}>
+          <span style={{ width: 7, height: 7, borderRadius: 999, background: STATUS_COLOR[n.status] ?? "var(--ink-dim)" }} />
+          {data.statusLabel}
+        </span>
+      </div>
+      <span style={{ fontFamily: "var(--quasar-font-display)", fontSize: "13px", color: "var(--ink-primary)", lineHeight: 1.25 }}>{data.label}</span>
+      {m ? (
+        <span style={{ fontFamily: "var(--quasar-font-mono)", fontSize: "10px", color: "var(--ink-muted)" }} title={m.unit}>
+          {m.label}: <b style={{ color: "var(--ink-primary)" }}>{fmt(m.value)}</b>
+        </span>
+      ) : null}
+    </div>
+  );
+}
+
+interface StockNodeData extends Record<string, unknown> {
+  label: string;
+  active: boolean;
+  /** Flujo de un lazo de un solo stock activo (s → s): se pinta como anillo, no como arista. */
+  selfLoop: string | null;
+}
+
+function StockNode({ data }: NodeProps<Node<StockNodeData>>) {
+  return (
+    <div className="relative flex items-center justify-center rounded-full"
+      style={{ width: 64, height: 64, background: data.active ? "rgba(58,160,255,0.22)" : "var(--surface-0)",
+        border: `1px solid ${data.active ? "var(--electric)" : "rgba(255,255,255,0.16)"}`,
+        fontFamily: "var(--quasar-font-mono)", fontSize: "12px", color: "var(--ink-primary)" }}>
+      <Handle type="target" position={Position.Top} style={{ ...hidden, left: "50%", top: "50%" }} />
+      <Handle type="source" position={Position.Bottom} style={{ ...hidden, left: "50%", top: "50%" }} />
+      {data.label}
+      {data.selfLoop ? (
+        <>
+          <span aria-hidden="true" style={{ position: "absolute", inset: -7, borderRadius: 999, border: "2px dashed var(--electric)" }} />
+          <span style={{ position: "absolute", top: 70, whiteSpace: "nowrap", fontSize: "10px", color: "var(--electric)",
+            background: "#0A0E14", padding: "1px 4px", borderRadius: 4 }}>↻ {data.selfLoop}</span>
+        </>
+      ) : null}
+    </div>
+  );
+}
+
+const nodeTypes: NodeTypes = { flow: FlowNode, stock: StockNode };
+
+/** Etiqueta y descripción traducidas por id de nodo; si el diccionario no lo tiene, el texto del backend. */
+function useNodeText() {
+  const t = useT();
+  return useCallback((n: GraphNode) => {
+    const pick = (key: "label" | "description", fallback: string) => {
+      const path = `world4.nodes.${n.id}.${key}`;
+      const v = t(path);
+      return v === path ? fallback : v;
+    };
+    return { label: pick("label", n.label), description: pick("description", n.description) };
+  }, [t]);
+}
+
+export function RunGraph({ data }: { data: World4RunData }) {
+  const t = useT();
+  const [mode, setMode] = useState<"flow" | "loops">("flow");
+  const [sel, setSel] = useState<string | null>(null);
+  const graph = data.graph;
+
+  if (!graph) return <Notice tone="info">{t("world4.missing")}</Notice>;
+  return (
+    <div className="flex flex-col gap-3">
+      <div className="flex flex-wrap items-center gap-2">
+        {(["flow", "loops"] as const).map((m) => (
+          <button key={m} type="button" onClick={() => setMode(m)} aria-pressed={mode === m}
+            className="rounded-md px-3 py-1.5"
+            style={{ fontFamily: "var(--quasar-font-mono)", fontSize: "12px",
+              background: mode === m ? "rgba(58,160,255,0.18)" : "transparent",
+              color: mode === m ? "var(--ink-primary)" : "var(--ink-dim)",
+              border: `1px solid ${mode === m ? "rgba(58,160,255,0.55)" : "rgba(255,255,255,0.12)"}` }}>
+            {m === "flow" ? t("world4.graph.modeFlow") : t("world4.graph.modeLoops")}
+          </button>
+        ))}
+        <span style={{ ...monoStyle, fontSize: "11px", color: "var(--ink-dim)", flex: 1, minWidth: 240 }}>
+          {mode === "flow" ? t("world4.graph.flowHelp") : t("world4.graph.loopsHelp")}
+        </span>
+      </div>
+      {mode === "flow" ? <FlowGraph data={data} sel={sel} onSel={setSel} /> : <LoopsGraph data={data} />}
+      <PolicyStrip data={data} />
+    </div>
+  );
+}
+
+function FlowGraph({ data, sel, onSel }: { data: World4RunData; sel: string | null; onSel: (id: string | null) => void }) {
+  const t = useT();
+  const text = useNodeText();
+  const g = data.graph!;
+  const { nodes, edges } = useMemo(() => {
+    const rows: Record<number, number> = {};
+    const ns: Node<FlowNodeData>[] = g.nodes.map((n) => {
+      const col = KIND_COLUMN[n.kind] ?? 5;
+      const row = rows[col] ?? 0;
+      rows[col] = row + 1;
+      return {
+        id: n.id, type: "flow", position: { x: col * COL_W, y: row * ROW_H },
+        data: { node: n, label: text(n).label, selected: n.id === sel, kindLabel: t(`world4.graph.kinds.${n.kind}`),
+          statusLabel: t(`world4.graph.status.${n.status}`) },
+      };
+    });
+    // centrar verticalmente cada columna
+    const tallest = Math.max(...Object.values(rows));
+    for (const node of ns) {
+      const col = KIND_COLUMN[node.data.node.kind] ?? 5;
+      node.position.y += ((tallest - (rows[col] ?? 0)) * ROW_H) / 2;
+    }
+    const es: Edge[] = g.edges.map((e) => {
+      const hot = sel !== null && (e.source === sel || e.target === sel);
+      const color = KIND_COLOR[g.nodes.find((n) => n.id === e.source)?.kind ?? "data"] ?? "#78909C";
+      return {
+        id: e.id, source: e.source, target: e.target, label: hot ? e.label : undefined,
+        animated: e.kind === "coupling" || e.kind === "policy" || hot,
+        style: { stroke: color, strokeWidth: hot ? 2.2 : 1.2, opacity: sel === null || hot ? 0.85 : 0.18 },
+        labelStyle: { fill: "var(--ink-primary)", fontSize: 10, fontFamily: "var(--quasar-font-mono)" },
+        labelBgStyle: { fill: "#0A0E14", fillOpacity: 0.9 },
+        markerEnd: { type: MarkerType.ArrowClosed, color, width: 14, height: 14 },
+      };
+    });
+    return { nodes: ns, edges: es };
+  }, [g, sel, t, text]);
+  const node = g.nodes.find((n) => n.id === sel) ?? null;
+  return (
+    <div className="grid gap-4" style={{ gridTemplateColumns: "minmax(0,1fr) 320px" }}>
+      <div className="overflow-hidden rounded-lg" style={{ height: 620, background: "#070b11", border: "1px solid rgba(255,255,255,0.06)" }}>
+        <ReactFlow nodes={nodes} edges={edges} nodeTypes={nodeTypes} fitView fitViewOptions={{ padding: 0.12 }}
+          minZoom={0.3} maxZoom={1.8} nodesDraggable nodesConnectable={false} proOptions={{ hideAttribution: true }}
+          onNodeClick={(_, n) => onSel(n.id === sel ? null : n.id)} onPaneClick={() => onSel(null)} colorMode="dark">
+          <Background color="rgba(255,255,255,0.06)" gap={24} />
+          <Controls showInteractive={false} />
+        </ReactFlow>
+      </div>
+      <NodeDetail node={node} />
+    </div>
+  );
+}
+
+function NodeDetail({ node }: { node: GraphNode | null }) {
+  const t = useT();
+  const text = useNodeText();
+  const card = { background: "var(--surface-0)", border: "1px solid rgba(255,255,255,0.06)" };
+  if (!node) {
+    return <div className="rounded-lg p-4" style={card}><span style={{ ...monoStyle, fontSize: "12px" }}>{t("world4.graph.pick")}</span></div>;
+  }
+  return (
+    <div className="flex flex-col gap-3 overflow-auto rounded-lg p-4" style={{ ...card, maxHeight: 620 }}>
+      <div className="flex flex-col gap-1">
+        <span style={{ ...labelStyle, color: KIND_COLOR[node.kind] }}>{t(`world4.graph.kinds.${node.kind}`)}</span>
+        <span style={{ fontFamily: "var(--quasar-font-display)", fontSize: "16px", color: "var(--ink-primary)" }}>{text(node).label}</span>
+        <span style={{ ...monoStyle, fontSize: "12px" }}>{text(node).description}</span>
+        <span><Badge tone={node.status === "ok" ? "ok" : node.status === "skipped" ? "dim" : "warn"}>{t(`world4.graph.status.${node.status}`)}</Badge></span>
+      </div>
+      {node.metrics.length ? (
+        <div className="flex flex-col gap-1">
+          <span style={labelStyle}>{t("world4.graph.metrics")}</span>
+          {node.metrics.map((m) => (
+            <div key={m.label} className="flex items-baseline justify-between gap-2">
+              <span style={{ ...monoStyle, fontSize: "11px" }}>{m.label}</span>
+              <span style={{ ...monoStyle, fontSize: "12px", color: "var(--ink-primary)", textAlign: "right" }}>
+                {fmt(m.value)} <span style={{ color: "var(--ink-dim)", fontSize: "10px" }}>{m.unit}</span>
+              </span>
+            </div>
+          ))}
+        </div>
+      ) : null}
+      {node.series ? (
+        <div className="flex flex-col gap-1">
+          <span style={labelStyle}>{t("world4.graph.series")} · {node.series.label}</span>
+          <BandSparkline years={node.series.years} p50={node.series.values} />
+          <span style={{ ...monoStyle, fontSize: "10px", color: "var(--ink-dim)" }}>{node.series.unit} · {node.series.band}</span>
+        </div>
+      ) : null}
+      {node.caveats?.length ? (
+        <div className="flex flex-col gap-1">
+          <span style={labelStyle}>{t("world4.graph.caveats")}</span>
+          {node.caveats.map((c) => <span key={c} style={{ ...monoStyle, fontSize: "11px", color: "var(--warning)" }}>· {c}</span>)}
+        </div>
+      ) : null}
+      {node.provenance && Object.keys(node.provenance).length ? (
+        <div className="flex flex-col gap-1">
+          <span style={labelStyle}>{t("world4.graph.provenance")}</span>
+          {Object.entries(node.provenance).map(([k, v]) => (
+            <span key={k} style={{ ...monoStyle, fontSize: "11px" }}>{k}: {Array.isArray(v) ? v.join(", ") : String(v)}</span>
+          ))}
+        </div>
+      ) : null}
+    </div>
+  );
+}
+
+function LoopsGraph({ data }: { data: World4RunData }) {
+  const t = useT();
+  const loops = data.graph?.loops;
+  const [decade, setDecade] = useState(0);
+  const [loopSel, setLoopSel] = useState<string | null>(null);
+  const table = loops?.dominant_by_decade ?? [];
+  const row = table[Math.min(decade, Math.max(table.length - 1, 0))];
+  const active = useMemo(() => {
+    const name = loopSel ?? row?.loops[0]?.loop ?? null;
+    const set = new Set<string>();
+    const stocks = new Set<string>();
+    if (name) {
+      const seq = name.split("->").map((p) => p.trim()).filter((p) => p.includes("-["))
+        .map((p) => { const [s, f] = p.split("-["); return { s: s.trim(), f: f.replace("]", "").trim() }; });
+      seq.forEach((x, i) => {
+        const next = seq[(i + 1) % seq.length].s;
+        set.add(`${x.s}|${next}|${x.f}`);
+        stocks.add(x.s);
+      });
+    }
+    return { name, set, stocks };
+  }, [loopSel, row]);
+  const score = row?.loops.find((l) => l.loop === active.name)?.score ?? null;
+
+  const { nodes, edges } = useMemo(() => {
+    if (!loops) return { nodes: [], edges: [] };
+    const R = 250;
+    const ns: Node<StockNodeData>[] = loops.stocks.map((s, i) => {
+      const a = (i / loops.stocks.length) * Math.PI * 2 - Math.PI / 2;
+      const self = loops.links.find((l) => l.source === s && l.target === s && active.set.has(`${s}|${s}|${l.flow}`));
+      return { id: s, type: "stock", position: { x: R * Math.cos(a), y: R * Math.sin(a) },
+        data: { label: s, active: active.stocks.has(s), selfLoop: self ? self.flow : null } };
+    });
+    const es: Edge[] = loops.links.filter((l) => l.source !== l.target).map((l, k) => {
+      const on = active.set.has(`${l.source}|${l.target}|${l.flow}`);
+      const pos = (score ?? 1) >= 0;
+      const color = on ? (pos ? "#3AA0FF" : "#f59e0b") : "rgba(176,190,197,0.35)";
+      return {
+        id: `${l.source}-${l.target}-${l.flow}-${k}`, source: l.source, target: l.target, label: on ? l.flow : undefined,
+        animated: on,
+        style: { stroke: color, strokeWidth: on ? 2.4 : 1, opacity: on ? 1 : 0.5 },
+        labelStyle: { fill: "var(--ink-primary)", fontSize: 10, fontFamily: "var(--quasar-font-mono)" },
+        labelBgStyle: { fill: "#0A0E14", fillOpacity: 0.9 },
+        markerEnd: { type: MarkerType.ArrowClosed, color, width: 12, height: 12 },
+      };
+    });
+    return { nodes: ns, edges: es };
+  }, [loops, active, score]);
+
+  if (!loops) return <Notice tone="info">{t("world4.graph.noLoops")}</Notice>;
+  return (
+    <div className="grid gap-4" style={{ gridTemplateColumns: "minmax(0,1fr) 320px" }}>
+      <div className="overflow-hidden rounded-lg" style={{ height: 620, background: "#070b11", border: "1px solid rgba(255,255,255,0.06)" }}>
+        <ReactFlow nodes={nodes} edges={edges} nodeTypes={nodeTypes} fitView fitViewOptions={{ padding: 0.15 }}
+          nodesConnectable={false} proOptions={{ hideAttribution: true }} colorMode="dark">
+          <Background color="rgba(255,255,255,0.06)" gap={24} />
+          <Controls showInteractive={false} />
+        </ReactFlow>
+      </div>
+      <div className="flex flex-col gap-3 rounded-lg p-4" style={{ background: "var(--surface-0)", border: "1px solid rgba(255,255,255,0.06)" }}>
+        <span style={labelStyle}>{t("world4.graph.decade", { year: row?.year ?? "—" })}</span>
+        <input type="range" min={0} max={Math.max(table.length - 1, 0)} value={decade}
+          onChange={(e) => { setDecade(Number(e.target.value)); setLoopSel(null); }} style={{ accentColor: "var(--electric)" }}
+          aria-label={t("world4.graph.decade", { year: row?.year ?? "—" })} />
+        <span style={labelStyle}>{t("world4.graph.topLoops")}</span>
+        {(row?.loops ?? []).map((l) => {
+          const on = l.loop === active.name;
+          return (
+            <button key={l.loop} type="button" onClick={() => setLoopSel(l.loop)} className="flex flex-col gap-1 rounded-md p-2 text-left"
+              style={{ background: on ? "rgba(58,160,255,0.12)" : "transparent", border: `1px solid ${on ? "rgba(58,160,255,0.5)" : "rgba(255,255,255,0.08)"}` }}>
+              <span style={{ ...monoStyle, fontSize: "11px", color: "var(--ink-primary)" }}>{l.loop}</span>
+              <div className="flex items-center gap-2">
+                <div className="h-1.5 flex-1 overflow-hidden rounded-full" style={{ background: "var(--surface-3)" }}>
+                  <div className="h-full" style={{ width: `${Math.min(Math.abs(l.score) * 100, 100)}%`, background: l.score >= 0 ? "#3AA0FF" : "#f59e0b" }} />
+                </div>
+                <span style={{ ...monoStyle, fontSize: "10px" }}>{t("world4.graph.score", { s: fmt(l.score, 2) })}</span>
+              </div>
+            </button>
+          );
+        })}
+        <span style={{ ...monoStyle, fontSize: "10px", color: "var(--ink-dim)" }}>{loops.unit} · {loops.band}</span>
+      </div>
+    </div>
+  );
+}
+
+function PolicyStrip({ data }: { data: World4RunData }) {
+  const t = useT();
+  const p = data.policy;
+  if (!p) return null;
+  const rows = [...Object.entries(p.objectives).map(([k, v]) => ({ k, v, b: p.baseline_objectives[k] })),
+    ...Object.entries(p.constraints).map(([k, v]) => ({ k, v, b: p.baseline_constraints[k] }))];
+  return (
+    <div className="flex flex-col gap-2 rounded-lg p-4" style={{ background: "var(--surface-0)", border: "1px solid rgba(255,255,255,0.06)" }}>
+      <div className="flex flex-wrap items-center gap-2">
+        <span style={labelStyle}>{t("world4.graph.objectivesTitle")}</span>
+        <Badge tone={p.feasible ? "ok" : "warn"}>{p.feasible ? t("world4.graph.feasible") : t("world4.graph.infeasible")}</Badge>
+        <span style={{ ...monoStyle, fontSize: "11px" }}>
+          {t("world4.graph.better", { w: pct(p.better_than_baseline_share.welfare), g: pct(p.better_than_baseline_share.peak_gmst) })}
+        </span>
+      </div>
+      <div className="grid gap-x-6 gap-y-1" style={{ gridTemplateColumns: "repeat(auto-fill, minmax(260px, 1fr))" }}>
+        {rows.map(({ k, v, b }) => (
+          <div key={k} className="flex items-baseline justify-between gap-2" title={p.units[k]}>
+            <span style={{ ...monoStyle, fontSize: "11px" }}>{k}</span>
+            <span style={{ ...monoStyle, fontSize: "12px", color: k in p.constraints && v > 0 ? "var(--warning)" : "var(--ink-primary)" }}>
+              {fmt(v)} <span style={{ color: "var(--ink-dim)", fontSize: "10px" }}>vs {fmt(b)}</span>
+            </span>
+          </div>
+        ))}
+      </div>
+    </div>
+  );
+}
diff --git a/frontend/src/components/world4/WorldExplorer.tsx b/frontend/src/components/world4/WorldExplorer.tsx
new file mode 100644
--- /dev/null
+++ b/frontend/src/components/world4/WorldExplorer.tsx
@@ -0,0 +1,140 @@
+"use client";
+
+// Explorador de World4 (F10): el slot `world_explorer` que el manifest de World4 declara con stage
+// "explorer". Tres pestañas sobre los datos de una corrida terminada (world.json, geo.json, graph.json,
+// policy.json): el globo 3D con los países como agentes, el grafo de la corrida y las preguntas a QUO y a
+// Prime Radiant. La corrida abierta en la vista manda; el selector permite volver a cualquier otra.
+
+import { useCallback, useEffect, useState } from "react";
+import { Globe2, MessageSquareText, RefreshCw, Workflow } from "lucide-react";
+
+import { useT } from "@/lib/i18n";
+import type { PhyRunSnapshot, PhySlot } from "@/lib/phyModels";
+import { listWorld4Runs, loadWorld4Run, type World4RunData } from "@/lib/world4";
+import { Badge, labelStyle, monoStyle, Notice, Panel } from "@/components/phy/ui";
