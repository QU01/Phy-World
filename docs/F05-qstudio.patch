@@ -0,0 +1,19 @@
+"""Estimador estructural World4 / Phy-World para Prime Radiant (F0.5, borrador de ADR 0016).
+
+World4 es la "capa cliodinámica" que el ADR 0013 dejaba fuera. Entra en el circuito con el
+mismo patrón que el simulador de actores:
+
+* Etapa ``structural`` después de la evidencia. Sólo corre si la bandera
+  ``QUASAR_PR_STRUCTURAL_ENABLED=1`` está puesta y la pregunta trae un enlace explícito
+  (``Question.structural``). En la v1 el enlace no lo propone ningún LLM.
+* Los analistas y Delphi NO la reciben. d1 se ejecuta otra vez CON el bloque y se guarda como
+  ``p_final_withstructural``; el pronóstico publicado sigue siendo el de sin bloque.
+* ``validation.gate()`` decide si alguna vez alimenta a d1 (W9b); en F0.5 devuelve siempre falso.
+* World4 corre en su propio entorno (versiones fijadas para su paridad bit a bit) y se llama
+  por subproceso: ``QUASAR_PR_WORLD4_PYTHON`` y ``QUASAR_PR_WORLD4_DIR``.
+* Un fallo de World4 nunca aborta la corrida: queda en ``structural_diagnostics``.
+
+Por qué la configuración no entra en ``SwarmConfig``: su huella identifica al calibrador y se
+recalcula para normalizar filas antiguas del ledger. Mientras World4 no alimente a d1 no cambia
+la procedencia del estimador publicado, y meterla ahí cambiaría todas las huellas existentes.
+"""
diff --git a/backend/app/services/prime_radiant/structural/runner.py b/backend/app/services/prime_radiant/structural/runner.py
new file mode 100644
index 0000000..2bc4ba9
--- /dev/null
+++ b/backend/app/services/prime_radiant/structural/runner.py
@@ -0,0 +1,117 @@
+"""Llamada a World4 por subproceso y traducción de su respuesta al circuito de Prime Radiant."""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import os
+import subprocess
+import time
+from datetime import datetime
+from pathlib import Path
+
+DIAGNOSTICS = {
+    "unbound": "structural_unbound",
+    "out_of_domain": "structural_out_of_domain",
+    "asof_violation": "structural_asof_violation",
+    "unavailable": "structural_unavailable",
+    "timeout": "structural_timeout",
+    "error": "structural_unavailable",
+}
+
+
+def enabled() -> bool:
+    return os.environ.get("QUASAR_PR_STRUCTURAL_ENABLED", "0").strip().lower() in {"1", "true", "yes", "on"}
+
+
+def settings() -> dict:
+    return {
+        "python": os.environ.get("QUASAR_PR_WORLD4_PYTHON", ""),
+        "dir": os.environ.get("QUASAR_PR_WORLD4_DIR", ""),
+        "timeout_s": float(os.environ.get("QUASAR_PR_WORLD4_TIMEOUT_S", "120")),
+    }
+
+
+def request_for(q, as_of: datetime) -> dict:
+    b = q.structural
+    req = {"variable": b.variable, "region": b.region, "as_of": as_of.date().isoformat(),
+           "closes_at": q.closes_at.date().isoformat(), "kind": "numeric" if q.kind == "numeric" else "binary"}
+    if q.kind == "numeric":
+        req["edges"] = list(q.edges or [])
+    return req
+
+
+def _call(req: dict, cfg: dict) -> dict:
+    py, root = cfg["python"], cfg["dir"]
+    if not py or not root or not Path(py).is_file() or not (Path(root) / "world4_cli.py").is_file():
+        return {"status": "unavailable",
+                "message": "World4 not configured: set QUASAR_PR_WORLD4_PYTHON and QUASAR_PR_WORLD4_DIR"}
+    try:
+        proc = subprocess.run(
+            [py, str(Path(root) / "world4_cli.py"), "--structural", "-"],
+            input=json.dumps(req), capture_output=True, text=True, encoding="utf-8",
+            timeout=cfg["timeout_s"], cwd=root,
+        )
+    except subprocess.TimeoutExpired:
+        return {"status": "timeout", "message": f"World4 took more than {cfg['timeout_s']:g} s"}
+    lines = [ln for ln in proc.stdout.splitlines() if ln.strip()]
+    try:
+        out = json.loads(lines[-1])
+    except (IndexError, json.JSONDecodeError):
+        return {"status": "error", "message": f"World4 exit {proc.returncode}: {proc.stderr[-500:]}"}
+    if not isinstance(out, dict) or "status" not in out:
+        return {"status": "error", "message": "World4 answered without a status"}
+    return out
+
+
+def _valid(out: dict, q) -> str | None:
+    """Comprueba la forma de un bloque 'ok' antes de dejarlo entrar en el resultado."""
+    if q.kind == "numeric":
+        dist = out.get("distribution")
+        ids = q.option_ids()
+        if not isinstance(dist, dict) or set(dist) != set(ids):
+            return "distribution does not match the question's intervals"
+        if any(not 0 <= v <= 1 for v in dist.values()) or abs(sum(dist.values()) - 1) > 1e-6:
+            return "invalid distribution"
+    else:
+        p = out.get("p")
+        if not isinstance(p, (int, float)) or not 0 <= p <= 1:
+            return "invalid probability"
+    return None
+
+
+async def estimate(q, as_of: datetime) -> tuple[dict | None, dict]:
+    """(bloque o None, campos para el resultado). Nunca lanza: el circuito sigue sin World4."""
+    t = time.monotonic()
+    if q.kind == "choice":
+        out = {"status": "unbound", "message": "World4 answers binary and numeric questions only"}
+    else:
+        out = await asyncio.to_thread(_call, request_for(q, as_of), settings())
+    seconds = round(time.monotonic() - t, 2)
+    status = out.get("status", "error")
+    if status == "ok":
+        problem = _valid(out, q)
+        if problem:
+            status, out = "error", {"status": "error", "message": problem}
+    diag = {"status": status, "code": None if status == "ok" else DIAGNOSTICS.get(status, "structural_unavailable"),
+            "message": out.get("message"), "seconds": seconds, "feeds_d1": False}
+    if status != "ok":
+        return None, {"structural_diagnostics": diag}
+    fields = {"structural": out, "structural_diagnostics": diag, "structural_feeds_d1": False}
+    if q.kind == "numeric":
+        fields["distribution_structural"] = out["distribution"]
+    else:
+        fields["p_structural"] = float(out["p"])
+        if out.get("base_rate_data"):
+            fields["base_rate_data"] = float(out["base_rate_data"]["p_window"])
+    return out, fields
+
+
+def decision_input(block: dict) -> dict:
+    """Lo que ve d1: la estimación, su dominio y sus límites; nunca la procedencia interna."""
+    keep = ("variable", "what", "region", "window", "origin", "k", "exploratory", "caveats", "p", "p_raw",
+            "distribution", "quantiles", "unit", "calibrator", "base_rate_data")
+    out = {k: block[k] for k in keep if k in block}
+    out["note"] = ("Structural model (World4 / Phy-World): an agent-based world-system model, recalibrated on "
+                   "past questions known at as_of. Treat it as one more estimator, not as evidence.")
+    return out
diff --git a/backend/app/services/prime_radiant/structural/validation.py b/backend/app/services/prime_radiant/structural/validation.py
new file mode 100644
index 0000000..838524d
--- /dev/null
+++ b/backend/app/services/prime_radiant/structural/validation.py
@@ -0,0 +1,35 @@
+"""W9b: la compuerta que decidiría si World4 alimenta a d1. En F0.5 nunca abre.
+
+Mismo contrato que ``simulation/validation.gate``: se recalcula desde las filas resueltas, nunca
+desde una bandera guardada. Abriría con N >= 30 preguntas resueltas que tengan d1 con y sin el
+bloque estructural y un IC95 bootstrap de la diferencia de Brier enteramente negativo. Aunque
+abriera, F0.5 no lo usa: alimentar a d1 exige meter World4 en la huella de calibración (F11).
+"""
+
+from __future__ import annotations
+
+import numpy as np
+
+MIN_N = 30
+
+
+def assess(rows: list[dict]) -> dict:
+    pairs = [(r["p_final_withstructural"], r["p_final"], r["outcome"]) for r in rows
+             if r.get("p_final_withstructural") is not None and r.get("p_final") is not None
+             and r.get("outcome") in (0, 1)]
+    out = {"n": len(pairs), "min_n": MIN_N, "passed": False}
+    if len(pairs) < MIN_N:
+        out["reason"] = f"W9b needs >= {MIN_N} resolved questions with d1 with and without World4; has {len(pairs)}"
+        return out
+    d = np.asarray([(w - y) ** 2 - (p - y) ** 2 for w, p, y in pairs])
+    rng = np.random.default_rng(42)
+    samples = [float(d[rng.integers(0, len(d), len(d))].mean()) for _ in range(2000)]
+    ci = np.quantile(samples, [0.025, 0.975]).tolist()
+    out.update(brier_delta=float(d.mean()), delta_ci95=ci, passed=bool(ci[1] < 0))
+    out["reason"] = "CI excludes 0" if out["passed"] else "CI includes 0"
+    return out
+
+
+def gate(rows: list[dict] | None = None) -> bool:
+    """F0.5: siempre False. ``assess`` informa; la promoción es una decisión de F11."""
+    return False
