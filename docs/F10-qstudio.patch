+"""Adaptador de Phy-World (World4) — F10 de su hoja de ruta (§5).
+
+World4 no es un modelo de diseño de piezas: θ son las 7 palancas de política de F8, las familias son los dos
+modos de su CLI que Studio ofrece (``scenario`` = ``--theta``, ``design`` = ``--design``) y la corrida devuelve,
+además del resultado, los datos del explorador (``world.json``: los países como agentes y los flujos;
+``geo.json``; ``graph.json``: el grafo de la corrida) que pinta el slot ``world_explorer``.
+
+Toda la lógica vive en el paquete (``world4.studio_compat.run_studio``, probada allí); aquí sólo se traduce el
+cfg del genérico y se declara lo que Studio necesita. Nada escribe fuera del run dir (C-1, D-111).
+"""
+from __future__ import annotations
+
+from pathlib import Path
+from types import SimpleNamespace
+
+from app.services.phy_models.models._base import HONESTY, PhyModelAdapter
+
+FAMILIES = ("scenario", "design")
+NARRATIVES = ("ssp1", "ssp2", "ssp3", "ssp4", "ssp5")
+
+
+def _num(value, default=None):
+    if value is None or value == "":
+        return default
+    return float(value)
+
+
+class World4Adapter(PhyModelAdapter):
+    model_id = "world4"
+
+    def prepare_namespace(self, ns: SimpleNamespace) -> SimpleNamespace:
+        ns.OUT_KEYS = list(ns.physics.OUT_KEYS)
+        return ns
+
+    # ── Spec ──────────────────────────────────────────────────────────────────
+
+    def build_spec(self, ns: SimpleNamespace, cfg: dict):
+        """World4 no tiene ``DesignSpec``: el spec ES el cfg traducido (lo valida ``run_studio``)."""
+        return self._cfg(ns, cfg)
+
+    def _cfg(self, ns: SimpleNamespace, cfg: dict) -> dict:
+        family = str(cfg.get("family") or FAMILIES[0])
+        out = {"family": family, "fidelity": str(cfg.get("fidelity") or "L0"),
+               "narrative": str(cfg.get("narrative") or "ssp2"), "seed": cfg.get("seed")}
+        for k in ("members", "l1_members", "rounds", "n_init"):
+            if cfg.get(k) not in (None, ""):
+                out[k] = int(float(cfg[k]))
+        if family == "scenario":
+            for name in ns.VAR_NAMES[family]:
+                out[name] = _num(cfg.get(name), 0.0)
+        else:
+            out["land_reported"] = str(cfg.get("land_limit") or "report") != "constrain"
+        return out
+
+    def spec_fields(self, ns: SimpleNamespace) -> list[dict]:
+        return [{**row, **({} if fam == "common" else {"family": fam})}
+                for fam, rows in (self.manifest.get("spec_fields") or {}).items() for row in rows]
+
+    def extra_schema(self, ns: SimpleNamespace) -> dict:
+        with ns.isolation.activate():
+            from world4.scenarios import levers, narratives
+            rows = levers.describe()
+            narr = {k: v["what"] for k, v in narratives.NARRATIVES.items()}
+        dv = [{"name": r["name"], "lo": float(r["box"][0]), "hi": float(r["box"][1]), "unit": r["unit"],
+               "what": r["what"]} for r in rows]
+        return {"design_vars": {f: dv for f in FAMILIES}, "narratives": narr,
+                "explorer": {"artifacts": ["world.json", "geo.json", "graph.json", "policy.json", "design.json"],
+                             "schema": "world4-explorer-1"}}
+
+    def validate(self, ns: SimpleNamespace, cfg: dict) -> list[dict]:
+        errs: list[dict] = []
+        family = cfg.get("family") or FAMILIES[0]
+        if cfg.get("narrative") not in (None, "") and cfg["narrative"] not in NARRATIVES:
+            errs.append({"campo": "narrative", "regla": "choice", "mensaje": f"narrative debe ser una de {list(NARRATIVES)}"})
+        for k in ("members", "l1_members"):
+            v = cfg.get(k)
+            if v in (None, ""):
+                continue
+            try:
+                ok = float(v) == int(float(v)) and int(float(v)) >= (8 if k == "l1_members" else 20)
+            except (TypeError, ValueError):
+                ok = False
+            if not ok:
+                errs.append({"campo": k, "regla": "entero_minimo",
+                             "mensaje": f"{k} debe ser un entero ≥ {8 if k == 'l1_members' else 20}"})
+        if family == "scenario":
+            lo = dict(zip(ns.VAR_NAMES["scenario"], ns.physics.BOUNDS_LO["scenario"]))
+            hi = dict(zip(ns.VAR_NAMES["scenario"], ns.physics.BOUNDS_HI["scenario"]))
+            for name in ns.VAR_NAMES["scenario"]:
+                try:
+                    v = _num(cfg.get(name), 0.0)
+                except (TypeError, ValueError):
+                    errs.append({"campo": name, "regla": "numero", "mensaje": f"{name} debe ser un número"})
+                    continue
+                if not (lo[name] - 1e-12 <= v <= hi[name] + 1e-12):
+                    errs.append({"campo": name, "regla": "caja_palanca",
+                                 "mensaje": f"{name} fuera de su caja [{lo[name]:g}, {hi[name]:g}] "
+                                            f"{ns.physics.UNITS[name]}"})
+        if cfg.get("land_limit") not in (None, "", "report", "constrain"):
+            errs.append({"campo": "land_limit", "regla": "choice", "mensaje": "land_limit: report | constrain"})
+        return errs
+
+    # ── Corrida ───────────────────────────────────────────────────────────────
+
+    def run_design(self, ns: SimpleNamespace, spec, cfg: dict,
+                   checkpoint_path: str | None, log) -> dict:
+        outdir = Path(checkpoint_path).parent if checkpoint_path else Path.cwd()
+        spec = dict(spec or self._cfg(ns, cfg))
+        spec["fidelity"] = str(cfg.get("fidelity") or spec.get("fidelity") or "L0")
+        with ns.isolation.activate():
+            return ns.physics.run_studio(spec, outdir, log=log)
+
+    def deliverables(self, ns: SimpleNamespace, result: dict, outdir: Path, cfg: dict) -> dict:
+        return {k: v for k, v in (result.get("deliverables") or {}).items() if (Path(outdir) / v).is_file()}
+
+    def normalize_result(self, result: dict, outdir: Path, cfg: dict) -> Path | None:
+        return None
+
+    # ── Evaluación puntual ────────────────────────────────────────────────────
+
+    def evaluate_theta(self, ns: SimpleNamespace, theta: list[float], *,
+                       fidelity: str = "L0", family: str | None = None) -> dict:
+        fam = family or FAMILIES[0]
+        with ns.isolation.activate():
+            rec = ns.physics.evaluate(theta, fidelity=fidelity, family=fam)
+        source = str(rec.get("source", ""))
+        return {"family": fam, "theta": dict(zip(ns.VAR_NAMES[fam], (float(v) for v in theta))),
+                "record": {k: v for k, v in rec.items() if isinstance(v, (int, float, str, bool))},
+                "source": source, "degraded": False, "honesty": HONESTY}
+
+    def reference_theta(self, ns: SimpleNamespace, family: str | None = None) -> list[float]:
+        """La referencia de World4 es NO hacer nada (θ = 0), no el centro de la caja."""
+        return [0.0] * len(ns.VAR_NAMES[family or FAMILIES[0]])
+
+
+ADAPTER = World4Adapter()
+
+__all__ = ["ADAPTER", "World4Adapter"]
