+// Cortes por defecto de las preguntas numéricas (la unidad sale del diccionario: world4.ask.units).
+const NUMERIC: Partial<Record<Variable, { edges: string }>> = {
+  gdp_pc_growth: { edges: "-2, 0, 2, 4" },
+  debt_gdp: { edges: "40, 60, 80, 100" },
+};
+
+const card: React.CSSProperties = { background: "var(--surface-0)", border: "1px solid rgba(255,255,255,0.06)" };
+const primaryBtn: React.CSSProperties = {
+  background: "var(--electric)", color: "#0A0E14", fontFamily: "var(--quasar-font-mono)", fontSize: "12px",
+};
+const ghostBtn: React.CSSProperties = {
+  background: "transparent", color: "var(--ink-primary)", border: "1px solid rgba(255,255,255,0.18)",
+  fontFamily: "var(--quasar-font-mono)", fontSize: "12px",
+};
+
+export function AskPanel({ data, family, fidelity, focus }: {
+  data: World4RunData;
+  family: string;
+  fidelity: string;
+  focus: AskTarget | null;
+}) {
+  return (
+    <div className="grid gap-4" style={{ gridTemplateColumns: "repeat(auto-fit, minmax(380px, 1fr))" }}>
+      {/* el foco (un país pedido desde el globo) remonta cada caja con su estado inicial */}
+      <QuoBox key={`quo-${focus?.target}-${focus?.iso3 ?? ""}`} data={data} family={family} fidelity={fidelity} focus={focus} />
+      <PrimeRadiantBox key={`pr-${focus?.iso3 ?? ""}`} data={data} focus={focus} />
+    </div>
+  );
+}
+
+// ── QUO ──────────────────────────────────────────────────────────────────────
+
+function QuoBox({ data, family, fidelity, focus }: { data: World4RunData; family: string; fidelity: string; focus: AskTarget | null }) {
+  const t = useT();
+  const messages = useAgentStream((s) => s.messages);
+  const streaming = useAgentStream((s) => s.isStreaming);
+  const [text, setText] = useState(() =>
+    focus?.target === "quo" && focus.name ? t("world4.ask.suggestions.country", { name: focus.name }) : "");
+  const [from, setFrom] = useState<number | null>(null);
+  const [state, setState] = useState<"idle" | "sending" | "queued">("idle");
+  const country = focus?.iso3 ? { iso3: focus.iso3, name: focus.name ?? focus.iso3 } : null;
+
+  const context = t("world4.ask.context", {
+    run: data.runId, family, fidelity, narrative: data.world.narrative,
+    country: country ? t("world4.ask.contextCountry", { name: country.name, iso3: country.iso3 }) : "",
+  });
+  const suggestions = [
+    ...(country ? [t("world4.ask.suggestions.country", { name: country.name })] : []),
+    t("world4.ask.suggestions.policy"),
+    ...(data.world.l1 ? [t("world4.ask.suggestions.drain")] : []),
+    t("world4.ask.suggestions.limits"),
+  ];
+
+  const send = async () => {
+    const q = text.trim();
+    if (!q) return;
+    setState("sending");
+    const store = useAgentStream.getState();
+    store.connect();
+    setFrom(store.messages.length);
+    const tool = country
+      ? `world4_read("run_country", {"run_id": "${data.runId}", "iso3": "${country.iso3}"})`
+      : `world4_read("run_summary", {"run_id": "${data.runId}"})`;
+    const r = await store.sendMessage(`${q}\n\n[${context} Read it with ${tool}.]`);
+    setState(r === "queued" ? "queued" : "idle");
+    setText("");
+  };
+
+  const thread = from === null ? [] : messages.slice(from);
+  return (
+    <div className="flex flex-col gap-3 rounded-lg p-4" style={card}>
+      <div className="flex items-center justify-between gap-2">
+        <span style={{ fontFamily: "var(--quasar-font-display)", fontSize: "16px", color: "var(--ink-primary)" }}>{t("world4.ask.quoTitle")}</span>
+        <button type="button" onClick={() => agentSwitchView("agente")} className="flex items-center gap-1 rounded-md px-2 py-1" style={ghostBtn}>
+          <ExternalLink size={12} /> {t("world4.ask.openChat")}
+        </button>
+      </div>
+      <span style={{ ...monoStyle, fontSize: "11px" }}>{t("world4.ask.quoHelp")}</span>
+      <div className="flex flex-wrap gap-1.5">
+        {suggestions.map((s) => (
+          <button key={s} type="button" onClick={() => setText(s)} className="rounded-full px-2.5 py-1 text-left"
+            style={{ ...monoStyle, fontSize: "11px", border: "1px solid rgba(255,255,255,0.12)", background: "var(--surface-1)" }}>
+            {s}
+          </button>
+        ))}
+      </div>
+      <textarea value={text} onChange={(e) => setText(e.target.value)} rows={3} placeholder={t("world4.ask.placeholder")}
+        style={{ ...inputStyle, resize: "vertical" }}
+        onKeyDown={(e) => { if (e.key === "Enter" && (e.ctrlKey || e.metaKey)) void send(); }} />
+      <span style={{ ...monoStyle, fontSize: "10px", color: "var(--ink-dim)" }}>{context}</span>
+      <div className="flex items-center gap-2">
+        <button type="button" onClick={() => void send()} disabled={!text.trim() || state === "sending"}
+          className="flex items-center gap-1.5 rounded-md px-3 py-1.5" style={{ ...primaryBtn, opacity: text.trim() ? 1 : 0.5 }}>
+          <Send size={12} /> {state === "sending" ? t("world4.ask.sending") : t("world4.ask.send")}
+        </button>
+        {state === "queued" ? <Badge tone="dim">{t("world4.ask.queued")}</Badge> : null}
+        {streaming && from !== null ? <Badge tone="warn">{t("world4.ask.streaming")}</Badge> : null}
+      </div>
+      <div className="flex flex-col gap-2 overflow-auto rounded-md p-3" style={{ maxHeight: 420, background: "var(--surface-1)" }}>
+        {thread.length ? thread.map((m) => (
+          <div key={m.id} className="flex flex-col gap-1">
+            <span style={{ ...labelStyle, fontSize: "10px", color: m.role === "user" ? "var(--ink-dim)" : "var(--electric)" }}>
+              {m.role === "user" ? t("world4.ask.you") : t("world4.ask.quo")}
+            </span>
+            {m.role === "user"
+              ? <span style={{ ...monoStyle, fontSize: "12px", whiteSpace: "pre-wrap" }}>{m.content.split("\n\n[")[0]}</span>
+              : <div style={{ fontSize: "13px", color: "var(--ink-primary)" }}><AgentMarkdown>{m.content}</AgentMarkdown></div>}
+          </div>
+        )) : <span style={{ ...monoStyle, fontSize: "12px", color: "var(--ink-dim)" }}>{t("world4.ask.empty")}</span>}
+      </div>
+    </div>
+  );
+}
+
+// ── Prime Radiant ────────────────────────────────────────────────────────────
+
+function PrimeRadiantBox({ data, focus }: { data: World4RunData; focus: AskTarget | null }) {
+  const t = useT();
+  const countries = useMemo(() => {
+    const list = data.world.l1?.countries ?? data.world.l0.countries ?? [];
+    const names = new Map(data.geo.features.map((f) => [f.id, f.properties.name]));
+    return list.map((c) => ({ iso3: c.iso3, name: names.get(c.isonum) ?? c.iso3 }))
+      .sort((a, b) => a.name.localeCompare(b.name));
+  }, [data]);
+  const lastYear = data.world.l1?.years.at(-1) ?? 2029;
+  const nextYear = new Date().getUTCFullYear() + 1;
+  const [variable, setVariable] = useState<Variable>("conflict");
+  const [iso3, setIso3] = useState<string>(focus?.iso3 ?? countries[0]?.iso3 ?? "USA");
+  const [year, setYear] = useState<number>(nextYear);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const name = countries.find((c) => c.iso3 === iso3)?.name ?? iso3;
+  // Lo escrito por el usuario vale para UNA combinación (variable, país, año); al cambiarla vuelve la plantilla.
+  const key = `${variable}|${iso3}|${year}`;
+  const [edit, setEdit] = useState<{ key: string; text?: string; rules?: string; edges?: string; created?: string }>({ key });
+  const mine = edit.key === key ? edit : { key };
+  const patch = (p: Partial<typeof edit>) => setEdit({ ...mine, ...p, key });
+  const text = mine.text ?? t(`world4.ask.templates.${variable}`, { name, year });
+  const rules = mine.rules ?? t(`world4.ask.rulesTemplates.${variable}`, { name, year });
+  const edges = mine.edges ?? NUMERIC[variable]?.edges ?? "";
+  const created = mine.created ?? null;
+
+  // Lo que dice la corrida para ese país y año (si cae en el horizonte del L1).
+  const world4Says = useMemo(() => {
+    const l1 = data.world.l1;
+    if (!l1) return null;
+    const i = l1.countries.findIndex((c) => c.iso3 === iso3);
+    const k = l1.years.indexOf(Math.min(year, lastYear));
+    if (i < 0 || k < 0) return null;
+    const v = (key: string) => (l1.series[key] ? centralValue(l1.series[key], i, k) : null);
+    switch (variable) {
+      case "conflict": return v("conflict") !== null ? pct(v("conflict")) : null;
+      case "coup": return v("coup") !== null ? pct(v("coup")) : null;
+      case "crisis": return v("crisis") !== null ? pct(v("crisis")) : null;
+      case "democracy": return v("democracy") !== null ? pct(v("democracy")) : null;
+      case "debt_gdp": return v("debt_gdp") !== null ? `${fmt((v("debt_gdp") as number) * 100)} ${t("world4.ask.units.debt_gdp")}` : null;
+      case "gdp_pc_growth": {
+        const g = growthGrid(l1)[i]?.[k];
+        return g !== null && g !== undefined ? `${fmt(g)} ${t("world4.ask.units.gdp_pc_growth")}` : null;
+      }
+    }
+  }, [data, iso3, year, variable, lastYear, t]);
+
+  const create = async () => {
+    setError(null);
+    if (text.trim().length < 5 || rules.trim().length < 5) return setError(t("world4.ask.errors.text"));
+    const body: Record<string, unknown> = {
+      text: text.trim(), rules: rules.trim(), closes_at: `${year}-12-31T23:59:59Z`,
+      structural: { variable, region: iso3 },
+    };
+    if (NUMERIC[variable]) {
+      const cuts = edges.split(",").map((s) => Number(s.trim())).filter((x) => Number.isFinite(x));
+      const ok = cuts.length >= 2 && cuts.length <= 11 && cuts.every((x, i) => i === 0 || x > cuts[i - 1]);
+      if (!ok) return setError(t("world4.ask.errors.edges"));
+      body.numeric = { unit: t(`world4.ask.units.${variable}`), edges: cuts };
+    }
+    setBusy(true);
+    try {
+      const q = await prApi<{ id: string }>("/questions", "POST", body);
+      patch({ created: q.id });
+    } catch (e) {
+      setError(e instanceof Error ? e.message : String(e));
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const field = { display: "flex", flexDirection: "column" as const, gap: 4 };
+  return (
+    <div className="flex flex-col gap-3 rounded-lg p-4" style={card}>
+      <span style={{ fontFamily: "var(--quasar-font-display)", fontSize: "16px", color: "var(--ink-primary)" }}>{t("world4.ask.prTitle")}</span>
+      <span style={{ ...monoStyle, fontSize: "11px" }}>{t("world4.ask.prHelp")}</span>
+      <div className="grid gap-3" style={{ gridTemplateColumns: "1fr 1fr 110px" }}>
+        <label style={field}>
+          <span style={labelStyle}>{t("world4.ask.variable")}</span>
+          <select value={variable} onChange={(e) => setVariable(e.target.value as Variable)} style={inputStyle}>
+            {VARIABLES.map((v) => <option key={v} value={v}>{t(`world4.ask.variables.${v}`)}</option>)}
+          </select>
+        </label>
+        <label style={field}>
+          <span style={labelStyle}>{t("world4.ask.country")}</span>
+          <select value={iso3} onChange={(e) => setIso3(e.target.value)} style={inputStyle}>
+            {countries.map((c) => <option key={c.iso3} value={c.iso3}>{c.name} ({c.iso3})</option>)}
+          </select>
+        </label>
+        <label style={field}>
+          <span style={labelStyle}>{t("world4.ask.closes")}</span>
+          <input type="number" min={nextYear - 1} max={nextYear + 10} value={year} onChange={(e) => setYear(Number(e.target.value))} style={inputStyle} />
+        </label>
+      </div>
+      {NUMERIC[variable] ? (
+        <label style={field}>
+          <span style={labelStyle}>{t("world4.ask.edges", { unit: t(`world4.ask.units.${variable}`) })}</span>
+          <input value={edges} onChange={(e) => patch({ edges: e.target.value })} style={inputStyle} />
+        </label>
+      ) : null}
+      <label style={field}>
+        <span style={labelStyle}>{t("world4.ask.text")}</span>
+        <textarea value={text} onChange={(e) => patch({ text: e.target.value })} rows={2} style={{ ...inputStyle, resize: "vertical" }} />
+      </label>
+      <label style={field}>
+        <span style={labelStyle}>{t("world4.ask.rules")}</span>
+        <textarea value={rules} onChange={(e) => patch({ rules: e.target.value })} rows={3} style={{ ...inputStyle, resize: "vertical" }} />
+      </label>
+      <Notice tone="info">
+        {world4Says ? t("world4.ask.world4Says", { year: Math.min(year, lastYear), value: world4Says }) : t("world4.ask.world4NoValue")}
+      </Notice>
+      {error ? <Notice tone="err">{error}</Notice> : null}
+      <div className="flex flex-wrap items-center gap-2">
+        <button type="button" onClick={() => void create()} disabled={busy} className="rounded-md px-3 py-1.5" style={primaryBtn}>
+          {busy ? t("world4.ask.creating") : t("world4.ask.create")}
+        </button>
+        {created ? (
+          <>
+            <Badge tone="ok">{t("world4.ask.created", { id: created.slice(0, 8) })}</Badge>
+            <button type="button" onClick={() => agentSwitchView("prime-radiant")} className="flex items-center gap-1 rounded-md px-2 py-1" style={ghostBtn}>
+              <ExternalLink size={12} /> {t("world4.ask.openPr")}
+            </button>
+          </>
+        ) : null}
+      </div>
+    </div>
+  );
+}
